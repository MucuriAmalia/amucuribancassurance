<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_prospects" pageWidth="1130" pageHeight="595" whenNoDataType="AllSectionsNoDetail" columnWidth="660" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1bf9c828-381b-4849-8fb8-dac124bc168d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="prospectId" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[select prs_id, prs_fname, prs_onames , prs_created_by, coalesce (sbp2.pol_client_pol_no, '') as pol_client_pol_no,
case when sbp2.pol_auth_status = 'A' then 'Converted' else 'Not Converted' end as pol_auth_status , 
coalesce (sbp2.pol_no, '') as pol_no,sbu2.user_name as converted_by , sbp2.pol_auth_date , sbb.ob_name, 
case when sbp.prs_status = 'A' then 'Active' else 'Terminated' end as prs_status,prs_datereg
from sys_brk_prospects sbp 
left join sys_brk_clients sbc on sbc.client_id = sbp.prs_clnt_code
left join sys_brk_policies sbp2 on sbp2.pol_client_id = sbc.client_id 
left join sys_brk_users sbu2 on sbu2.user_id = sbp2.pol_created_user
left join sys_brk_branches sbb on sbb.ob_id = sbp2.pol_branch_id
where (prs_id::varchar) = coalesce ($P{prospectId}, (prs_id::varchar))
 and sbp.prs_datereg between $P{dateFrom}  and $P{dateTo}]]>
	</queryString>
