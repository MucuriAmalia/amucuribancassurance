	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Local Adapter"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="acctId" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[select pr_code, pr_desc, sbb.bin_name , sbpg.bpg_desc , sbb.bin_sht_desc , sba.acct_id, sba.acct_name ,
sbb.created_by , sbb.created_date , sbb.modified_by , sbb.modified_date , 
sbb.bin_auth_status, sbb.bin_max_term, sbb.bin_min_term , user_absa_no,
sbpc.sap_prod_code ,  sbb.bin_pol_no,sap_prod_descriptipn
from sys_brk_binders sbb 
inner join sys_brk_accounts sba on sba.acct_id = sbb.bin_acct_code
inner join sys_brk_products sbp on sbp.pr_code = sbb.bin_pr_code
inner join sys_brk_account_types sbat on sbat.acc_id = sba.acct_acc_code
inner join sys_brk_product_grp sbpg on sbpg.bpg_code = sbp.pr_bpg_code
left join sys_brk_product_codes sbpc on sbpc.sap_prod_id = sbp.pr_sap_code
left join sys_brk_users sbu on sbu.user_sub_agent = sba.acct_id 
 where COALESCE($P{acctId} IS NULL OR sba.acct_id = CAST($P{acctId} AS BIGINT))
   AND cast(sbb.created_date as date)  between  $P{dateFrom} AND  $P{dateTo}]]>
	</queryString>
