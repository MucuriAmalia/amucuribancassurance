<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_receipt_allocations" pageWidth="1530" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="1455" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" uuid="1b49ce42-35ed-48c3-99c9-8e7331c9a53e">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="teddy"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="clientid" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="format" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT   
    sbr.receipt_id, receipt_no,alloc_date,
    alloc_amt,alloc_ref_no,
    pol_no,trans_amount,
    sbc.client_fname,
    sbc.client_onames,
    sbc.client_id, 
    sbr.receipt_payment_ref,
    sbrd.rect_amount,
    sbr.receipt_doc_date::date,
    sbmt.trans_balance,
    sblr.lrct_balance,
    alloc_paid_to_date,
    sbr.receipt_date::date,
    sbpm.pm_desc ,
    sbmt.trans_ref_no
FROM sys_brk_life_rct_allocs sblra
INNER JOIN sys_brk_life_rcts sblr ON sblra.alloc_lrct_id = sblr.lrct_id
INNER JOIN sys_brk_main_transactions sbmt ON sblr.lrct_trans_no = sbmt.trans_no
left join sys_brk_receipts sbr on sblr.lrct_receipt_id = sbr.receipt_id
LEFT JOIN sys_brk_receipt_dtls sbrd ON sbrd.rect_receipt_no =  sbr.receipt_id
left join sys_brk_receipt_dtls sbrd1 on sbmt.trans_no  =sbrd1.rect_trans_no 
left join sys_brk_life_rcts sblr1 on sblr1.lrct_trans_no= sbmt.trans_no
LEFT JOIN sys_brk_users sbu ON sbr.receipt_user =  sbu.user_id     
LEFT JOIN  sys_brk_policies sbp on sbrd.rect_pol_id  =  sbp.pol_id
LEFT JOIN sys_brk_clients sbc ON sbc.client_id = sbp.pol_client_id
left join sys_brk_trans sbt on sblra.alloc_tran_no = sbt.tran_no 
left join sys_brk_payment_modes sbpm ON sbp.pol_pmode_id = pm_id 
where   (client_id::varchar)  =  COALESCE($P{clientid} ,(client_id::varchar))
 and CAST( alloc_date AS date) BETWEEN $P{dateFrom} and  $P{dateTo}]]>
	</queryString>
