<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_income_statement" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="500bb39a-8d5a-4467-84dd-714081ce27af">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="current_year" class="java.lang.Integer"/>
	<parameter name="previous_year" class="java.lang.Integer"/>
	<parameter name="format" class="java.lang.String" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[SELECT
  sbgt.gl_year,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '3%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS Total_income,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '31%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS commissions_income,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '32%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS distribution_fee_income,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '41%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS agent_commission_expenses,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '4%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS total_expenses,
  ROUND(
    SUM(
      CASE 
        WHEN sbcs.co_code LIKE '3111%' OR sbcs.co_code LIKE '3121%' 
        THEN sbgt.gl_amount 
        ELSE 0 
      END
    )
  , 0) AS captive_policies_total,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '3111%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS captive_life,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '3121%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS captive_general,
  ROUND(
    SUM(
      CASE 
        WHEN sbcs.co_code LIKE '3112%' OR sbcs.co_code LIKE '3122%' 
        THEN sbgt.gl_amount 
        ELSE 0 
      END
    )
  , 0) AS non_captive_policies_total,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '3112%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS non_captive_life,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '3122%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS non_captive_general,
  ROUND(
    SUM(
      CASE 
        WHEN sbcs.co_code LIKE '3211%' OR sbcs.co_code LIKE '3221%' 
        THEN sbgt.gl_amount 
        ELSE 0 
      END
    )
  , 0) AS distribution_captive_total,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '3211%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS distribution_captive_life,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '3221%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS distribution_captive_general,
  ROUND(
    SUM(
      CASE 
        WHEN sbcs.co_code LIKE '3212%' OR sbcs.co_code LIKE '3222%' 
        THEN sbgt.gl_amount 
        ELSE 0 
      END
    )
  , 0) AS distribution_non_captive_total,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '3212%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS distribution_non_captive_life,
  ROUND(
    SUM(CASE WHEN sbcs.co_code LIKE '3222%' THEN sbgt.gl_amount ELSE 0 END)
  , 0) AS distribution_non_captive_general
FROM sys_brk_gl_trans sbgt
JOIN sys_brk_coa_sub sbcs
  ON sbgt.gl_account = sbcs.co_id
WHERE sbgt.gl_year IN ($P{current_year}, $P{previous_year})
GROUP BY sbgt.gl_year
ORDER BY sbgt.gl_year;]]>
	</queryString>
