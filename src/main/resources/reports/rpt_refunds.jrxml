	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.Object"/>
	<queryString>
		<![CDATA[select distinct
trans_ref_no as refund_number,
trans_date as refund_date,
sbu.user_name as authorizer,
sbu2.user_name as initiator,
sbmc.check_on_date as checkdate,
sbmc.made_on_date as madeon,
sbmc.task_name as narration,
client_fname || ' ' || client_onames AS client_name,
sbus.user_name as paid_by,
pol_no,
trans_settle_amt,
trans_balance
from  sys_brk_main_transactions sbmt
left join sys_brk_policies sbp on sbp.pol_id =  sbmt.trans_pol_id
LEFT join sys_brk_maker_checker sbmc on sbmc.task_pol_id = sbp.pol_id
left join sys_brk_users sbu on sbu.user_id = sbmc.checker_id
left join sys_brk_users sbu2 on sbu2.user_id = sbmc.maker_id
inner join sys_brk_clients on  trans_clnt_code = client_id
left join sys_brk_trans sbt on sbt.tran_no = sbmt.trans_tran_no
left join sys_brk_users sbus on sbus.user_id = sbt.tran_done_by
where sbmt.trans_type = 'RF'
AND sbmt.trans_date BETWEEN $P{dateFrom} AND $P{dateTo}]]>
	</queryString>
