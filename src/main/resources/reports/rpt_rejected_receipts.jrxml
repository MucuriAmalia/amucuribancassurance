<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_rejected_tickets" pageWidth="2000" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1152" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" uuid="1bf9c828-381b-4849-8fb8-dac124bc168d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="absa_insurance"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[WITH extracted_data AS (
    SELECT 
        mck_id,
        task_name,
        task_json,
        maker_id,
        rejected_reason,
        maker_task_type,
        made_on_date,
        check_on_date,
        CASE 
            WHEN check_status = 'R' THEN 'Rejected' 
            ELSE 'Approved' 
        END AS check_status,
        CAST((task_json::json ->> 'acctId') AS BIGINT) AS extracted_acctId,
        task_json::json -> 'insurance' ->> 'name' as insurance_name,
        task_json::json ->> 'paymentRef' AS paymentRef,
        task_json::json ->> 'paidBy' AS paidBy,
        task_json::json ->> 'receiptNo' AS receiptNo,
        CAST(task_json::json ->> 'receiptAmount' AS NUMERIC) AS receiptAmount,
        task_json::json -> 'branch' ->> 'obName' AS branchName,
        task_json::json ->> 'receiptDate' as receiptDate,
        task_json::json ->'receiptUser' ->> 'name' as receiptBy,
        checker_id,
        details.value ->> 'transNo' AS transNo,
        details.value ->> 'transTempNo' AS transTempNo
    FROM sys_brk_maker_checker sbmc,
         LATERAL jsonb_array_elements(sbmc.task_json::jsonb -> 'details') AS details
    WHERE check_status = 'R'
)
SELECT 
    ed.mck_id, 
    ed.task_name,
    ed.task_json::text AS task_json_text,
    ed.maker_id, 
    ed.checker_id,
    ed.check_status,
    ed.rejected_reason,
    ed.maker_task_type,
    ed.transNo, 
   	ed.transTempNo,
    ed.extracted_acctId,
    ed.paymentRef,
    ed.paidBy,
    ed.receiptNo,
    ed.receiptAmount,
    sbu.user_name AS maker_name,
    ed.made_on_date,  
    sbu2.user_name AS checker_name, 
    ed.check_on_date,  
    coalesce (sba.acct_name, ed.insurance_name) as insurance_name,
    sba.acct_brn_code,
    CASE 
        WHEN ed.maker_task_type = 'IM' THEN sbb.ob_name
        WHEN ed.maker_task_type = 'RC' THEN ed.branchName
        ELSE NULL
    END AS branchName,
    sb.bin_name,
    sba.acct_id,
    ed.receiptDate,
    ed.receiptBy,
    coalesce(sbp.pr_desc, sbp2.pr_desc) as pr_desc,
    coalesce(sbpg.bpg_desc,sbpg2.bpg_desc) as bpg_desc,
    ROUND(EXTRACT(EPOCH FROM (ed.check_on_date - ed.made_on_date)) / 60, 2)  AS "Time Pending with (Minutes)"
FROM extracted_data ed
LEFT JOIN sys_brk_users sbu ON sbu.user_id = ed.maker_id
LEFT JOIN sys_brk_accounts sba ON sba.acct_id = ed.extracted_acctId
LEFT JOIN sys_brk_users sbu2 ON sbu2.user_id = ed.checker_id
LEFT JOIN sys_brk_main_transactions sbmt ON sbmt.trans_no = CAST(ed.transNo AS BIGINT)
LEFT JOIN sys_brk_temp_transactions sbtt ON sbtt.trans_no = CAST(ed.transTempNo AS BIGINT)
LEFT JOIN sys_brk_branches sbb ON sbb.ob_id = sba.acct_brn_code
LEFT JOIN sys_brk_binders sb ON sb.bin_acct_code = sba.acct_id
LEFT JOIN sys_brk_policies p ON p.pol_id = sbmt.trans_pol_id
LEFT JOIN sys_brk_policies p2 ON p2.pol_id = sbtt.trans_pol_id
LEFT JOIN sys_brk_products sbp ON sbp.pr_code = p.pol_prod_id
LEFT JOIN sys_brk_products sbp2 ON sbp2.pr_code = p2.pol_prod_id
LEFT JOIN sys_brk_product_grp sbpg ON sbpg.bpg_code = sbp.pr_bpg_code
LEFT JOIN sys_brk_product_grp sbpg2 ON sbpg2.bpg_code = sbp2.pr_bpg_code
WHERE check_on_date BETWEEN $P{dateFrom} AND $P{dateTo};]]>
	</queryString>
