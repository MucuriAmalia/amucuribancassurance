	<queryString language="SQL">
		<![CDATA[select "DESCRIPTION" , "LOCATION" , "NO OF EMPLOYEES" ,"ESTIMATED ANNUAL SALARIES"
from "EMPLOYERS LIABILITY" el  
inner join sys_brk_risks sbr on sbr.risk_id = el.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
