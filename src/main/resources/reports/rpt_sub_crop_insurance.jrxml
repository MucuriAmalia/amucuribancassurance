	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "CHASIS NUMBER" , "REG.MARK", "ESTIMATED VALUE","TONNAGE", "YEAR OF MANUFACTURE"as YOM, "MAKE/MODEL","ENGINE NUMBER", "LOGBOOK NO"
from "MOTOR PRIVATE SCHEDULE" mps 
inner join sys_brk_risks sbr on sbr.risk_id = mps.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
