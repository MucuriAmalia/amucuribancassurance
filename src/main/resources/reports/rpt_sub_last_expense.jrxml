	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "NO" , "NAME" , "OCCUPATION" ,"FUNERAL EXPENSES" , "EST NO", "EST.ANNUAL EARNINGS" ,"AGE" 
from "LAST EXPENSE" le   
inner join sys_brk_risks sbr on sbr.risk_id = le.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
