	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "SUM INSURED", "DESCRIPTION", s_brk_risks_id
from "ALL RISKS" ar
inner join sys_brk_risks sbr on sbr.risk_id = ar.s_brk_risks_id
inner join sys_brk_covertypes sbc2 on sbc2.cov_id = sbr.risk_cover_id 
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
