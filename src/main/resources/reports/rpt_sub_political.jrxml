	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select sum_assured, "Location", property_insured
from "POLITICAL VIOLENCE AND TERRORISM" pvat 
inner join sys_brk_risks sbr on sbr.risk_id = pvat.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
