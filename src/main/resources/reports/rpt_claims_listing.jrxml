<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_claims_listing" pageWidth="4850" pageHeight="605" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1162" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="40" uuid="23a07438-245c-4eed-b6df-048a58b30f40">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="absaa"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="470"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="523"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="format" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DISTINCT
    sbc.client_fname || ' ' || sbc.client_onames AS client_names,
    sbc.client_idno,
    sbsss.seg_name,
    casu.ca_desc AS claim_activity,
    
    -- Modified: Translate claimant_type codes
    CASE
        WHEN sbcc.clm_clmnt_tp = 'S' THEN 'Insured'
        WHEN sbcc.clm_clmnt_tp = 'T' THEN 'Third Party'
        ELSE sbcc.clm_clmnt_tp
    END AS claimant_type,
    
    COALESCE(sbcp.clm_prl_reserve, 0) AS claim_estimate_amount,
    acct_name,
    ob_name,
    clm_no,
    clm_act_notes,
    clm_date,
    pol_no,
    sbp2.prs_fname || ' ' || sbp2.prs_onames AS prospect_names,
    bpg_desc,
    sbr.risk_sht_desc,
    clm_booked_dt,
    clm_loss_date,
    sbu.user_name,
    
    -- Modified: Translate clm_status
    CASE
        WHEN sbcb.clm_status = 'R' THEN 'Rejected'
        WHEN sbcb.clm_status = 'C' THEN 'Closed'
        WHEN sbcb.clm_status = 'B' THEN 'Booked'
        ELSE sbcb.clm_status
    END AS clm_status,
    
    sbp4.p_desc,
    COALESCE(sbcp.clm_prl_paid_amount, 0) AS clm_prl_paid_amount,
    sbs.activity_date,
    sbs.client_decision,
    sbs.decline_reason,
    sbs.dv_execution_date,
    sbs.dv_issuance_date,
    sbs.dv_offer_amount,
    sbs.final_settlement_date,
    
    -- Modified: Translate clm_close_reason
    CASE
        WHEN sbs.clm_close_reason = 'ST' THEN 'Closed As Settled'
        WHEN sbs.clm_close_reason = 'RJ' THEN 'Closed As Rejected'
        WHEN sbs.clm_close_reason = 'NC' THEN 'Closed As No Claim'
        WHEN sbs.clm_close_reason = 'RC' THEN 'Repairs Completed'
        WHEN sbs.clm_close_reason = 'DV' THEN 'CIL DV Issued'
        WHEN sbs.clm_close_reason = 'CD' THEN 'Claim Declined'
        ELSE sbs.clm_close_reason
    END AS clm_close_reason,
    
    acti.clm_act_status_id,
    ca_desc,
    clm_act_insurer_ref,
    clm_act_rem_dt

FROM sys_brk_accounts sba
LEFT JOIN sys_brk_policies sbp ON sba.acct_id = sbp.pol_agent_id
LEFT JOIN sys_brk_risks sbr ON sbr.risk_pol_id = sbp.pol_id
INNER JOIN sys_brk_clm_bookings sbcb ON sbcb.clm_risk_id = sbr.risk_id
LEFT JOIN sys_brk_branches sbb ON sbb.ob_id = sbp.pol_branch_id
LEFT OUTER JOIN sys_brk_clients sbc ON sbc.client_id = sbp.pol_client_id
LEFT OUTER JOIN sys_brk_prospects sbp2 ON sbp2.prs_id = sbp.pol_client_id
LEFT JOIN sys_brk_segments sbsss ON sbsss.seg_id = sbc.client_segment_code
LEFT JOIN sys_brk_products sbp3 ON sbp3.pr_code = sbp.pol_prod_id
LEFT JOIN sys_brk_product_grp sbpg ON sbpg.bpg_code = sbp3.pr_bpg_code
LEFT JOIN sys_brk_users sbu ON sbu.user_id = sbcb.clm_booked_by
LEFT JOIN sys_brk_clm_perils sbcp ON sbcp.clm_prl_clm_id = sbcb.clm_id
LEFT JOIN sys_brk_perils sbp4 ON sbp4.p_code = sbcp.clm_prl_peril_id
LEFT JOIN sys_brk_clm_activities acti ON sbcb.clm_id = acti.clm_act_clm_id
LEFT JOIN sys_brk_causations casu ON acti.clm_act_status_id = casu.ca_id
LEFT JOIN sys_brk_clm_statuses sbs ON sbs.clm_sts_clm_id = sbcb.clm_id
LEFT JOIN sys_brk_clm_claimants sbcc ON sbcc.clm_clmnt_clm_id = sbcb.clm_id

WHERE CAST(pol_agent_id AS VARCHAR) = COALESCE($P{Agent}, CAST(pol_agent_id AS VARCHAR))
  AND CAST(clm_date AS DATE) BETWEEN $P{dateFrom} AND $P{dateTo}
]]>
	</queryString>
