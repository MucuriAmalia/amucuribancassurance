<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_sub_agents_comm" pageWidth="4700" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1902" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f295ff76-4097-4e7d-ae8a-2ef1703fc0f3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Latest Adapter"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="747"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="242"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="SubAgent" class="java.lang.String"/>
	<parameter name="Introducer" class="java.lang.String"/>
	<parameter name="Marketer" class="java.lang.String"/>
	<parameter name="Branch" class="java.lang.String"/>
	<parameter name="Region" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT distinct  sbmt.trans_date::date AS trans_date,
sbc.client_id, sbc.client_idno, sbc.client_pin, sbc.client_fname, sbc.client_onames, sbc.client_cif,
sba.acct_name, sbp.pol_no, sbp.pol_ref_no AS risk_note_number, sbp.pol_client_pol_no AS pol_client_pol_no, sbmt.trans_ref_no,sbmt.value_date,
sbr.risk_sht_desc risk_sht_desc, EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) AS age_in_days,
    CASE
        WHEN EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) BETWEEN 0 AND 30 THEN 'current'
        WHEN EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) BETWEEN 31 AND 60 THEN 'under pay'
        WHEN EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) BETWEEN 61 AND 90 THEN 'over pay'
        ELSE 'over 90'
    END AS payment_status,
    sbp.pol_cover_to, sbp.pol_cover_from,
    CASE
        WHEN sbmt.trans_type = 'SAG' THEN 'Sub agent commission'
        else sbmt.trans_type
    END AS trans_type,
    sp.pr_desc,
    CASE
        WHEN sbrg.bpg_desc = 'LIFE' THEN 'LONG TERM'
        ELSE 'SHORT TERM'
    END AS insurance_type,
    sbrg.bpg_type, sbc2.cov_desc,
    CASE
        WHEN bpg_type = 'L' THEN COALESCE(pol_sum_insur_amt, 0)
        ELSE COALESCE(ABS(sbp.pol_total_sum_insured), 0)
    END AS pol_total_sum_insured,
    COALESCE(sbp.pol_sum_insur_amt, 0) AS pol_sum_insur_amt,
    COALESCE(sbp.pol_training_levy, 0) + COALESCE(sbp.pol_phcf, 0) AS taxes,
    COALESCE(sbmt.trans_settle_amt, 0) AS trans_settle_amt,
    abs(CASE
        WHEN bpg_type = 'L' THEN COALESCE(alloc_comm_amt, 0)
        ELSE CASE
            WHEN COALESCE(sbp.pol_total_comm, 0) > 0 THEN COALESCE(sbp.pol_total_comm, 0)
            ELSE COALESCE(sbp.pol_comm_amt, 0) * -1
        END
    end)* sign(sbp.pol_basic_premium_amt) AS pol_total_comm,
    alloc_comm_amt,
    pol_basic_premium_amt AS gross_premium,
    abs( CASE
        WHEN bpg_type = 'L' THEN COALESCE(alloc_life_whtx_amt, 0)
        ELSE CASE
            WHEN COALESCE(sbp.pol_total_whtx, 0) > 0 THEN COALESCE(sbp.pol_total_whtx, 0)
            ELSE COALESCE(sbp.pol_whtx, 0)
        END
    end)*-sign(sbp.pol_basic_premium_amt) AS pol_total_whtx,
    COALESCE(sbmt.trans_amount, 0) AS basic_premium,
    COALESCE(sbmt.trans_balance, 0) AS trans_balance,
    COALESCE(sbmt.trans_extras, 0) AS trans_extras,
    CASE
        WHEN bpg_type = 'L' THEN COALESCE(life_admin_fee, 0)
        ELSE COALESCE(sbp.pol_admin_fee_amt, 0)
    END AS pol_admin_fee_amt,
    CASE
        WHEN bpg_type = 'L' THEN COALESCE(life_admin_fee_vat, 0)
        ELSE COALESCE(sbp.pol_admin_vat_amt, 0)
    END AS pol_admin_vat_amt,
    sbu.user_name, sbbs.cl_desc, sba.acct_id,
    COALESCE(sbp.pol_introducer_agent_amt, 0) AS pol_introducer_agent_amt,
    sba3.acct_name AS sub_acct_name,
    sba3.acct_absa_no AS sub_acct_code,
    sba1.acct_absa_no AS introducer_code,
    sba2.acct_absa_no AS marketer_code,
    sba1.acct_name AS introducer_name,
    sba2.acct_name AS marketer_name,
    COALESCE(sbp.pol_introducer_agent_amt, 0) AS pol_introducer_agent_amt,
    abs(CASE
        WHEN bpg_type = 'L' THEN COALESCE(marketer_life_comm, 0)
        ELSE COALESCE(sbp.pol_marketer_agent_amt, 0)
    end)* sign(sbp.pol_basic_premium_amt) AS pol_marketer_agent_amt,
    abs(CASE
        WHEN bpg_type = 'L' THEN COALESCE(subagent_life_comm, 0)
        ELSE COALESCE(sbp.pol_sub_agent_amt, 0)
    end) *sign(sbp.pol_basic_premium_amt) AS sub_agent_comm,
    COALESCE(pol_stamp_duty, 0) AS pol_stamp_duty,
    sbre.reg_desc, sbb.ob_name, sbsg.seg_name, sbu.user_absa_no, sbu.user_name AS initiator_name, bpg_desc,
    sp.pr_sap_code,
    CASE 
    WHEN sbc.client_segment IS NOT NULL AND sbc.client_segment != '' 
    THEN sbc.client_segment 
    ELSE sbsg.seg_name 
END AS segment,
CASE 
    WHEN sbmt.trans_lf_endors_no IS NOT NULL AND sbmt.trans_lf_endors_no != '' 
    THEN sbmt.trans_lf_endors_no
    ELSE sbp.pol_rev_no 
END AS pol_rev_no, alloc_paid_to_date,
CASE 
    WHEN sbrg.bpg_type = 'L' THEN
        CASE 
            WHEN sbmt.trans_type = 'NBD' THEN coalesce(sbmt.value_date, sbmt.trans_date)
            ELSE COALESCE(att.alloc_paid_to_date, sbmt.value_date, sbmt.trans_date)
        END
    ELSE coalesce(sbmt.value_date, sbmt.trans_date)
END AS value_datee
FROM sys_brk_main_transactions sbmt
INNER JOIN sys_brk_clients AS sbc ON sbc.client_id = sbmt.trans_clnt_code
INNER JOIN sys_brk_policies AS sbp ON sbp.pol_id = sbmt.trans_pol_id
INNER JOIN sys_brk_accounts AS sba ON sba.acct_id = sbp.pol_agent_id
INNER JOIN sys_brk_risks AS sbr ON sbr.risk_pol_id = sbp.pol_id
INNER JOIN sys_brk_products AS sp ON sp.pr_code = sbp.pol_prod_id
INNER JOIN sys_brk_product_grp AS sbrg ON sbrg.bpg_code = sp.pr_bpg_code
INNER JOIN sys_brk_covertypes sbc2 ON sbc2.cov_id = sbr.risk_cover_id
INNER JOIN sys_brk_users AS sbu ON sbu.user_id = sbp.pol_created_user
INNER JOIN sys_brk_prod_subcls AS sps ON sps.ps_pr_code = sp.pr_code
INNER JOIN sys_brk_subclasses AS sbs ON sbs.sub_id = sps.ps_sub_code
INNER JOIN sys_brk_classes AS sbbs ON sbbs.cl_id = sbs.sub_cl_code
INNER JOIN sys_brk_account_types AS sbat ON sbat.acc_id = sba.acct_acc_code
LEFT JOIN sys_brk_accounts sba1 ON sba1.acct_id = sbp.pol_introducer_agent_id
LEFT JOIN sys_brk_accounts sba2 ON sba2.acct_id = sbp.pol_marketer_agent_id
LEFT JOIN sys_brk_sectors AS sbrs ON sbrs.sector_id = sbc.client_sector_id
LEFT JOIN sys_brk_accounts sba3 ON sba3.acct_id = sbp.pol_sub_agent_id
LEFT JOIN sys_brk_branches sbb ON sbb.ob_id = sbp.pol_branch_id
LEFT JOIN sys_brk_regions sbre ON sbre.reg_code = sbb.ob_reg_code
LEFT JOIN sys_brk_segments sbsg ON sbsg.seg_id = sbc.client_segment_code
JOIN sys_brk_main_transactions sbmt_nbd ON sbmt_nbd.trans_tran_no  = sbmt.trans_tran_no
JOIN sys_receipts_settlements srs on srs.rec_settle_cr_ref =  sbmt_nbd.trans_ref_no
LEFT JOIN sys_brk_life_rcts sbf ON sbp.pol_id = sbf.lrct_policy_id
LEFT JOIN (
    SELECT sbf2.lrct_policy_id, 
           alloc_paid_to_date,
           SUM(coalesce(sla.alloc_life_whtx_amt,0)) AS alloc_life_whtx_amt,
           SUM(coalesce(sla.alloc_comm_amt,0)) AS alloc_comm_amt,
           SUM(coalesce(sla.alloc_marketer_comm_amt, 0)) AS marketer_life_comm,
           SUM(coalesce(sla.alloc_subagent_comm_amt,0)) AS subagent_life_comm,
           SUM(coalesce(sla.alloc_admin_fee_amt,0)) AS life_admin_fee,
           SUM(coalesce(sla.alloc_admin_fee_whtx_amt,0)) AS life_admin_fee_vat
    FROM sys_brk_life_rct_allocs sla
    INNER JOIN sys_brk_life_rcts sbf2 ON sbf2.lrct_id = sla.alloc_lrct_id
    WHERE alloc_paid_to_date = (
        SELECT MAX(alloc_paid_to_date) 
        FROM sys_brk_life_rct_allocs sla2 
        INNER JOIN sys_brk_life_rcts sbf3 ON sbf3.lrct_id = sla2.alloc_lrct_id
        WHERE sbf3.lrct_policy_id = sbf2.lrct_policy_id
    )
    GROUP BY sbf2.lrct_policy_id, alloc_paid_to_date
) att ON sbp.pol_id = att.lrct_policy_id
WHERE sbmt.trans_type IN ('SAG')
AND sbmt.trans_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second'
and sbmt_nbd.trans_balance = 0
and sbmt_nbd.trans_type = 'RC'
GROUP BY sbmt.trans_no, sbmt.trans_date, sbc.client_id, sbc.client_idno, sbc.client_pin, 
         sbc.client_fname, sbc.client_onames, sbc.client_cif, sbrs.sector_name,
         sba.acct_name, sbp.pol_no, sbp.pol_ref_no, sbp.pol_client_pol_no, sbmt.trans_ref_no,
         sbmt.value_date, sbr.risk_sht_desc, sbp.pol_cover_from, sbp.pol_cover_to,
         sbmt.trans_type, sp.pr_desc, sbrg.bpg_desc, sbrg.bpg_type, sbc2.cov_desc,
         sbp.pol_sum_insur_amt, sbp.pol_total_sum_insured, sbp.pol_training_levy, sbp.pol_phcf,
         sbmt.trans_settle_amt, sbp.pol_total_comm, sbp.pol_comm_amt, sbp.pol_basic_premium_amt,
         sbp.pol_total_whtx, sbp.pol_whtx, sbmt.trans_amount, sbmt.trans_balance, sbmt.trans_extras,
         sbp.pol_admin_fee_amt, sbp.pol_admin_vat_amt, sbu.user_name, sbbs.cl_desc, sba.acct_id,
         sbp.pol_introducer_agent_amt, sba3.acct_name, sba3.acct_absa_no, sba1.acct_absa_no,
         sba2.acct_absa_no, sba1.acct_name, sba2.acct_name, sbp.pol_marketer_agent_amt,
         sbp.pol_sub_agent_amt, pol_stamp_duty, sbre.reg_desc, sbb.ob_name, sbsg.seg_name,
         sbu.user_absa_no, bpg_desc, sp.pr_sap_code, sbp.pol_rev_no,subagent_life_comm, 
         alloc_comm_amt, alloc_life_whtx_amt, life_admin_fee, life_admin_fee_vat, marketer_life_comm, alloc_paid_to_date
ORDER BY trans_date asc;]]>
	</queryString>
