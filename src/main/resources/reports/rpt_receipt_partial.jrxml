	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="647"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="353"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.Object"/>
	<queryString>
		<![CDATA[WITH payments AS (
  SELECT
    sbr.receipt_date,
    sbr.receipt_no,
    sbr.receipt_paid_by,
    sbr.receipt_amount,
    sbp.pol_id,
    sbp.pol_outstanding_prem AS current_outstanding,
    sbr.receipt_payment_ref,
    sbmt.trans_ref_no,
    sbr.receipt_amt_words,
    sbr.receipt_desc,
    sbrd.rect_narration,
    sbrd.rect_amount,
    sbrd.rect_endorse_no,
    sbpm.pm_desc,
    sbca.ca_name,
    sbp.pol_no,
    client_fname || ' ' || client_onames AS client_name
  FROM sys_brk_policies        sbp
  JOIN sys_brk_receipt_dtls    sbrd ON sbp.pol_id    = sbrd.rect_pol_id
  JOIN sys_brk_receipts        sbr  ON sbr.receipt_id = sbrd.rect_receipt_no
  LEFT JOIN sys_brk_payment_modes sbpm ON sbp.pol_pmode_id    = sbpm.pm_id
  LEFT JOIN sys_brk_collect_accts   sbca ON sbca.ca_pm_id      = sbpm.pm_id
  LEFT JOIN sys_brk_main_transactions sbmt ON sbmt.trans_pol_id = sbp.pol_id
  LEFT JOIN sys_brk_clients           ON sbmt.trans_clnt_code = client_id
  WHERE sbp.pol_outstanding_prem <> 0
AND sbr.receipt_date BETWEEN $P{dateFrom} AND $P{dateTo}
)
, with_running AS (
  SELECT
    *,
    -- running total of payments up to this row
    SUM(receipt_amount)
      OVER (
        PARTITION BY pol_id
        ORDER BY receipt_date, receipt_no
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
      ) AS cumulative_paid,

    -- reconstruct original premium = today’s outstanding + total payments ever made
    ( current_outstanding
      + SUM(receipt_amount) OVER (PARTITION BY pol_id)
    ) AS original_premium
  FROM payments
)

SELECT
   receipt_date,
   receipt_no,
   receipt_paid_by,
   receipt_amount,
   pol_id,
   receipt_payment_ref,
   trans_ref_no,
   receipt_amt_words,
   receipt_desc,
   rect_narration,
   rect_amount,
   rect_endorse_no,
   pm_desc,
   ca_name,
   pol_no,
   client_name,

   -- true per-row balance:
   (original_premium - cumulative_paid) AS balance

FROM with_running
ORDER BY receipt_date, receipt_no;]]>
	</queryString>
