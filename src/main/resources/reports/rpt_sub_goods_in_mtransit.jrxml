	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "DESCRIPTION" , "BASIS OF VALUATION" , "METHOD OF TRANSIT" ,"COVER TYPE" ,"LOCATION" ,
GIT."SUM INSURED ", GIT."ESTIMATED ANNUAL CARRY","REFERRED TO", "APPLICABLE  EXCESS" 
from "GOODS IN TRANSIT" git 
inner join sys_brk_risks sbr on sbr.risk_id = git.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
