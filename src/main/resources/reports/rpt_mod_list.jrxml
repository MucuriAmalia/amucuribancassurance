<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_mod_list" pageWidth="1441" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7febc191-3a58-4bc9-ad57-119ac4c402f8">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<parameter name="Branch" class="java.lang.String"/>
	<parameter name="pmode" class="java.lang.String"/>
	<parameter name="format" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT distinct org_name,org_mobile ,org_phone,org_address,org_website,phy_address,
add_email_addr,pol_id, pol_pmode_id, pm_desc, pol_agent_id, acct_name,acct_sht_desc, pol_wef_date,
 pol_wef_date, pol_date, pol_trans_type, pol_no, pol_branch_id, ob_name,
 pol_client_id, client_fname||' '||client_onames client_name, pol_current_status, pol_ref_no, risk_sht_desc,
 COALESCE(pol_sum_insur_amt, 0) AS pol_sum_insur_amt,
 COALESCE(pol_endos_basic_prem, 0) AS pol_endos_basic_prem,
 COALESCE(pol_net_premium_amt, 0) AS pol_net_premium_amt,
 COALESCE(pol_comm_amt, 0) AS pol_comm_amt,
 COALESCE(pol_endos_comm, 0) AS pol_endos_comm,
 COALESCE(pol_net_premium_amt, 0) AS pol_net_premium_amt,
 pol_stamp_duty, pol_training_levy, pol_extras, pol_phcf,pol_no
FROM sys_brk_organization,sys_brk_policies
INNER JOIN sys_brk_payment_modes ON pm_id = pol_pmode_id
INNER JOIN sys_brk_accounts ON acct_id = pol_agent_id
INNER JOIN sys_brk_branches sbb ON ob_id = pol_branch_id
INNER JOIN sys_brk_risks ON risk_pol_id =pol_id
INNER JOIN sys_brk_clients ON client_id = pol_client_id
where pol_auth_status ='A'
AND (($P{Branch} IS NULL) OR (sbb.ob_id::varchar = $P{Branch}::varchar))
AND (($P{pmode} IS NULL) OR (pm_id::varchar= $P{pmode}::varchar))
AND pol_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second'
ORDER BY pol_branch_id, pol_pmode_id, pol_date desc]]>
	</queryString>
