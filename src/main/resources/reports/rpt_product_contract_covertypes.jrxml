	<parameter name="format" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DISTINCT ON (bin_name)
    pr_desc, 
    bin_name, 
    bpg_desc, 
    acct_name, 
    cov_desc
FROM sys_brk_binders sbb
LEFT JOIN sys_brk_accounts sba ON sba.acct_id = sbb.bin_acct_code
LEFT JOIN sys_brk_products sbp ON sbp.pr_code = sbb.bin_pr_code
LEFT JOIN sys_brk_account_types sbat ON sbat.acc_id = sba.acct_acc_code
LEFT JOIN sys_brk_product_grp sbpg ON sbpg.bpg_code = sbp.pr_bpg_code
LEFT JOIN sys_brk_policies sbpo ON sbpo.pol_prod_id = sbp.pr_code
LEFT JOIN sys_brk_risks sbr ON sbr.risk_pol_id = sbpo.pol_id
LEFT JOIN sys_brk_covertypes sbct ON sbct.cov_id = sbr.risk_cover_id
WHERE (cov_desc IS NOT NULL AND cov_desc != '')
AND sbpo.pol_date BETWEEN $P{dateFrom} AND $P{dateTo};]]>
	</queryString>
