	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "LOGBOOK NO", "YEAR OF MANUFACTURE"as YOM, "WINDSCREEN","COVER TYPE", "REG.MARK", "PASSENGERS","INSURED'S ESTIMATE" as Estimated_Value
from "MOTOR PSV" mpsv
inner join sys_brk_risks sbr on sbr.risk_id = mpsv.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
