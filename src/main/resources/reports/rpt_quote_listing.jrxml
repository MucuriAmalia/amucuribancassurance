<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_quote_listing" pageWidth="1870" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1582" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="20" uuid="23a07438-245c-4eed-b6df-048a58b30f40">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ABSA"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="Branch" class="java.lang.String"/>
	<parameter name="Product" class="java.lang.String"/>
	<parameter name="createdBy" class="java.lang.String"/>
	<parameter name="format" class="java.lang.String"/>
	<queryString>
		<![CDATA[select org_name, org_mobile, org_phone,org_address, org_website, phy_address, add_email_addr, client_fname,
client_onames, client_address, client_sht_desc, quot_no, acct_name as agn_sht_desc, sbu.user_name, quot_auth_date, quot_date,
sbu1.user_name as auth_user, pr_desc, quot_pr_wef, quot_pr_wet,quot_pr_basic_prem, sbb.ob_name, (0-quot_comm_amt) as comm_amount, 
case 
	when sbq.quot_status ='C'
	then 'CONVERTED'
	ELSE 'NOT CONVERTED'
end  as  quot_status
from sys_brk_organization sbo, sys_brk_quot_products sbqp 
inner join sys_brk_quotations sbq  on sbq.quot_id = sbqp.quot_pr_quot_id
inner JOIN sys_brk_clients ON sbq.quot_client_id = client_id
inner JOIN sys_brk_accounts ON sbqp.quot_pr_agent_id = acct_id
left join sys_brk_users sbu ON sbu.user_id = sbq.quot_prep_user 
left join sys_brk_users sbu1 ON sbu1.user_id = sbq.quot_auth_user 
inner join sys_brk_products sbp on sbp.pr_code = sbqp.quot_pr_pro_id 
inner join sys_brk_branches sbb on sbb.ob_id = sbq.quot_branch_id
where quot_date between $P{dateFrom}::date  and $P{dateTo}::date
and (acct_id::varchar) = COALESCE( $P{Agent},(acct_id::varchar))
and (ob_id::varchar) = COALESCE( $P{Branch},(ob_id::varchar))
and (pr_code::varchar) = COALESCE( $P{Product},(pr_code::varchar))
and (sbq.quot_prep_user ::varchar) = COALESCE( $P{createdBy},(sbq.quot_prep_user ::varchar))
ORDER BY quot_branch_id, quot_date DESC]]>
	</queryString>
