<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_premiums" pageWidth="6246" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1700" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f295ff76-4097-4e7d-ae8a-2ef1703fc0f3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Latest Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="90"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="903"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="905"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="81"/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="format" class="java.lang.String"/>
	<queryString>
		<![CDATA[with ranked_trans as (
select
	distinct

org_mobile,
	org_address,
	org_phone,
	add_email_addr,
	org_name,
	org_website,
	sbmt.trans_no,
	sbmt.trans_date::date as trans_date,
	sbmt.trans_agent_code,
	sbmt.trans_pol_id,
	sbc.client_id,
	client_idno,
	client_pin,
	sbc.client_fname,
	sbc.client_onames,
	sbs2.seg_name,
	sba.acct_name,
	sbp.pol_no,
	sbp.pol_client_pol_no,
	REGEXP_REPLACE(sbmt.trans_ref_no, '([-\/][0-9]+)$', '') as trans_ref_no,
	--sbmt.trans_ref_no,

	risk_sht_desc,
	sbp.pol_cover_to,
	sbp.pol_cover_from,
	sba.acct_id,
	sbc2.cov_desc,
	ROUND(extract(year from AGE(sbp.pol_cover_to, sbp.pol_cover_from))) as cover_period_years,
	case
		when sbmt.trans_type = 'ADJ'

then 'JOURNALS'
		when trans_type = 'RED'
		and pol_trans_type = 'CN'

then 'CANCELLATION'
		when trans_type = 'CNC'
		and pol_trans_type = 'CN' then 'CANCELLATION'
		when trans_type = 'APD'
		and pol_trans_type = 'EX'

then 'EXTENSION'
		when trans_type = 'APD'
		and pol_trans_type = 'EN'

then 'ENDORSEMENT'
		when trans_type = 'RPC'
		and pol_trans_type = 'EN'

then 'ENDORSEMENT'
		when trans_type = 'BNK'

then 'BANK CHARGES'
		when trans_type = 'CFO'
		and pol_trans_type = 'JVC'

then 'CLAIM PAYMENT BY JOURNAL'
		when trans_type = 'CFO'
		and pol_trans_type = 'CF'

then 'CLAIM FEE'
		WHEN trans_type = 'NBR'  THEN 'CONTRA'
        WHEN trans_type = 'RNR'  THEN 'CONTRA'
		when trans_type = 'NBR'
		and pol_trans_type = 'CO' then 'CONTRA'
		when trans_type = 'CO'
		and pol_trans_type = 'PM'

then 'PAYMENTS'
		when trans_type = 'COM'

then 'COMMISSION POSTING'
		when trans_type = 'CPO'

then 'CLAIM PAYMENT'
		when trans_type = 'CRI'

then 'CLAIM RECOVERY'
		when trans_type = 'CRI'

then 'CLAIM SALVAGE'
		when trans_type = 'DED'

then 'DECLARATION'
		when trans_type = 'LOP'

then 'CLAIM OPENING'
		when trans_type = 'LRV'
		and pol_trans_type = 'RP'

then 'CLAIM REOPENING'
		when trans_type = 'LRV'
		and pol_trans_type = 'LR'

then 'CLAIM REVISION'
		when trans_type = 'MEC'

then 'MID TERM ENDORSEMENT'
		when trans_type = 'NBD'

then 'NEW BUSINESS'
		when trans_type = 'RC'

then 'RECEIPTS'
		when pol_trans_type = 'RE'

then 'REINSTATEMENT'
		when trans_type = 'RED'

then 'REINSTATEMENT'
		when trans_type = 'RFC'

then 'REFUND'
		when trans_type = 'RII'

then 'REINSURANCE TRANSACTION'
		when trans_type = 'NBC'
		and pol_trans_type = 'CO'

then 'Reversal'
		when trans_type = 'RND'
		and pol_trans_type != 'CO'

then 'RENEWAL'
		when trans_type = 'SPD'

then 'SHORT PERIOD'
		when trans_type = 'CN'

then 'Receipt Cancellation'
		when trans_type = 'SAG'

then 'Sub agent commission'
		when trans_type = 'APD'
		and pol_trans_type != 'CO'

then 'Additional Premium'
		when trans_type = 'APC'
		and pol_trans_type != 'CO'

then 'Refund Premium'
		when pol_trans_type = 'CO'

then 'Reversal'
		when trans_type = 'BUD'

then 'BULK UPLOAD'
	end as TRAN_DESC,
	sp.pr_desc,
	case
		when sbrg.bpg_desc = 'LIFE' then 'LONG TERM'
		else 'SHORT TERM'
	end as insurance_type,
	sbrg.bpg_desc,
	sbrg.bpg_type,
	sbbs.cl_desc,
	sbp.pol_basic_premium_amt,
	case
		when bpg_type = 'L' then coalesce(pol_sum_insur_amt, 0)
		else coalesce(ABS(sbp.pol_total_sum_insured), 0)
	end as pol_total_sum_insured,
	coalesce(sbp.pol_sum_insur_amt, 0) as pol_sum_insur_amt,
	coalesce(sbp.pol_training_levy, 0) + coalesce(sbp.pol_phcf, 0) as taxes,
	coalesce(sbmt.trans_settle_amt, 0) as trans_settle_amt,
	ABS(case

when bpg_type = 'L' then coalesce(alloc_comm_amt, 0)

else coalesce(sbp.pol_total_comm, sbp.pol_comm_amt * -1)

end) * SIGN(sbp.pol_basic_premium_amt) as pol_total_comm,
	sbp.pol_basic_premium_amt as gross_premium,
	ABS(case

when bpg_type = 'L' then coalesce(alloc_life_whtx_amt, 0)

else coalesce(sbp.pol_total_whtx, sbp.pol_whtx)

end) * -SIGN(sbp.pol_basic_premium_amt) as pol_total_whtx,
	sbmt.trans_amount as basic_premium,
	sbmt.trans_balance,
	coalesce(trans_extras, 0) as trans_extras,
	coalesce(pol_stamp_duty, 0) as pol_stamp_duty,
	case
		when sbp.pol_interface_type = 'C' then coalesce(sbu_rc.user_name, sbu.user_name)
		else sbu.user_name
	end as authorizer,
	case
		when sbp.pol_interface_type = 'C' then coalesce(sbu_rc.user_absa_no, sbu.user_absa_no)
		else sbu.user_absa_no
	end as authorizer_code,
	sbu_init.user_name as initiator,
	sbu_init.user_absa_no as initiator_code,
	sba3.acct_name as sub_acct_name,
	sba3.acct_sht_desc as sub_acct_code,
	sba1.acct_sht_desc as introducer_code,
	sba2.acct_sht_desc as marketer_code,
	sba1.acct_name as introducer_name,
	sba2.acct_name as marketer_name,
	sbc.client_cif,
	sbp.pol_accrual_instl_date,
	sbp.accrual_payment_type,
	case
		when sbp.pol_interface_type = 'C' then 'cash'
		when sbp.pol_interface_type = 'A' then 'Accrual'
		else sbp.pol_interface_type
	end as pol_interface_type,
	coalesce(sbp.pol_introducer_agent_amt, 0) as pol_introducer_agent_amt,
	ABS(case

when bpg_type = 'L' then coalesce(marketer_life_comm, 0)

else coalesce(sbp.pol_marketer_agent_amt, 0)

end) * SIGN(sbp.pol_basic_premium_amt) as pol_marketer_agent_amt,
	ABS(case

when bpg_type = 'L' then coalesce(subagent_life_comm, 0)

else coalesce(sbp.pol_sub_agent_amt, 0)

end) * SIGN(sbp.pol_basic_premium_amt) as sub_agent_comm,
	sbp.pol_underwriter_trans_code,
	sbut.user_name as timiza_initiator,
	sbutt.user_name as timiza_authorizer,
	sbum.user_name as mortgage_initiator,
	sbumm.user_name as mortgage_authorizer,
	sbue.user_name as emebedded_package_initiator,
	sbuee.user_name as emebedded_package_authorizer,
	sbucu.user_name as credit_life_initiator,
	sbucuu.user_name as credit_life_authorizer,
	sbucsu.user_name as credit_shield_initiator,
	sbucsuu.user_name as credit_shield_authorizer,
	sbugl.user_name as group_life_initiator,
	sbugll.user_name as group_life_authorizer,
	sbueri.user_name as embeded_retrechment_initiator,
	sbuerii.user_name as embeded_retrechment_authorizer,
	sbucc.user_name as embedded_credit_card_initator,
	sbuccc.user_name as embedded_credit_card_authorizer,
	sbubsm.user_name as absa_staff_motor_initiator,
	sbubsmm.user_name as absa_staff_motor_authorizer,
	sbutws.user_name as wezesha_initiator,
	sbutwss.user_name as wezesha_authorizer,
	sbs2.seg_name as segment,
	case
		when sbmt.trans_lf_endors_no is not null
		and sbmt.trans_lf_endors_no != ''

then sbmt.trans_lf_endors_no
		else sbp.pol_rev_no
	end as pol_rev_no,
	att.alloc_paid_to_date,
	case
		when sbrg.bpg_type = 'L' then

case
			when sbmt.trans_type = 'NBD' then coalesce(sbmt.value_date, sbmt.trans_date)
			else coalesce(att.alloc_paid_to_date, sbmt.value_date, sbmt.trans_date)
		end
		else coalesce(sbmt.value_date, sbmt.trans_date)
	end as value_datee,
	row_number() over (

partition by REGEXP_REPLACE(sbmt.trans_ref_no, '-[0-9]+$', '')
order by
	sbmt.trans_date desc

) as rn
from
	sys_brk_organization,
	sys_brk_main_transactions sbmt
inner join sys_brk_clients sbc on
	sbc.client_id = sbmt.trans_clnt_code
inner join sys_brk_policies sbp on
	sbp.pol_id = sbmt.trans_pol_id
inner join sys_brk_accounts sba on
	sba.acct_id = sbp.pol_agent_id
left join sys_brk_accounts sba1 on
	sba1.acct_id = sbp.pol_introducer_agent_id
left join sys_brk_accounts sba2 on
	sba2.acct_id = sbp.pol_marketer_agent_id
left join sys_brk_accounts sba3 on
	sba3.acct_id = sbp.pol_sub_agent_id
inner join sys_brk_risks sbr on
	sbr.risk_pol_id = sbp.pol_id
inner join sys_brk_products sp on
	sp.pr_code = sbp.pol_prod_id
inner join sys_brk_product_grp sbrg on
	sbrg.bpg_code = sp.pr_bpg_code
inner join sys_brk_covertypes sbc2 on
	sbc2.cov_id = sbr.risk_cover_id
inner join sys_brk_prod_subcls sps on
	sps.ps_pr_code = sp.pr_code
inner join sys_brk_subclasses sbs on
	sbs.sub_id = sps.ps_sub_code
inner join sys_brk_classes sbbs on
	sbbs.cl_id = sbs.sub_cl_code
left join sys_brk_sectors sbrs on
	sbrs.sector_id = sbc.client_sector_id
left join sys_brk_segments sbs2 on
	client_segment_code = seg_id
left join sys_brk_trans sbt on
	trans_tran_no = tran_no
left join sys_brk_trans_timiza sbtt on
	sbtt.timiza_pol_id = sbp.pol_id
left join sys_brk_users sbut on
	sbut.user_id = sbtt.timiza_uploaded_by
left join sys_brk_users sbutt on
	sbutt.user_id = sbtt.timiza_processed_by
left join sys_brk_mortgage_life_renewals sbmlr on
	sbmlr.mortgage_life_pol_id = sbp.pol_id
left join sys_brk_users sbum on
	sbum.user_id = sbmlr.mortgage_uploaded_by
left join sys_brk_users sbumm on
	sbumm.user_id = sbmlr.mortgage_processed_by
left join sys_brk_embed_package_insurance sbeu on
	sbeu.embed_policy_pol_id = sbp.pol_id
left join sys_brk_users sbue on
	sbue.user_id = sbeu.embed_uploaded_by
left join sys_brk_users sbuee on
	sbuee.user_id = sbeu.embed_processed_by
left join sys_brk_credit_life sbcl on
	sbcl.credit_life_pol_id = sbp.pol_id
left join sys_brk_users sbucu on
	sbucu.user_id = sbcl.credit_uploaded_by
left join sys_brk_users sbucuu on
	sbucuu.user_id = sbcl.credit_processed_by
left join sys_brk_credit_shield_bulk_upload sbcsu on
	sbcsu.card_pol_id = sbp.pol_id
left join sys_brk_users sbucsu on
	sbucsu.user_id = sbcsu.card_uploaded_by
left join sys_brk_users sbucsuu on
	sbucsuu.user_id = sbcsu.card_processed_by
left join sys_brk_group_life sbglu on
	sbglu.group_policy_pol_id = sbp.pol_id
left join sys_brk_users sbugl on
	sbugl.user_id = sbglu.group_uploaded_by
left join sys_brk_users sbugll on
	sbugll.user_id = sbglu.group_processed_by
left join sys_brk_embed_retrench_insurance sberi on
	sberi.retrench_policy_pol_id = sbp.pol_id
left join sys_brk_users sbueri on
	sbueri.user_id = sberi.retrench_uploaded_by
left join sys_brk_users sbuerii on
	sbuerii.user_id = sberi.retrench_processed_by
left join sys_brk_credit_card sbcc on
	sbcc.card_pol_id = sbp.pol_id
left join sys_brk_users sbucc on
	sbucc.user_id = sbcc.card_uploaded_by
left join sys_brk_users sbuccc on
	sbuccc.user_id = sbcc.card_processed_by
left join sys_brk_bulk_staff_motors sbbsm on
	sbbsm.bulk_policy_pol_id = sbp.pol_id
left join sys_brk_users sbubsm on
	sbubsm.user_id = sbbsm.bulk_policy_uploaded_by
left join sys_brk_users sbubsmm on
	sbubsmm.user_id = sbbsm.bulk_policy_processed_by
left join sys_brk_trans_wezesha_stock sbtws on
	sbtws.wezesha_stock_pol_id = sbp.pol_id
left join sys_brk_users sbutws on
	sbutws.user_id = sbtws.wezesha_stock_uploaded_by
left join sys_brk_users sbutwss on
	sbutwss.user_id = sbtws.wezesha_stock_processed_by
left join (
	select
		distinct on
		(task_pol_id)

task_pol_id,
		maker_id
	from
		sys_brk_maker_checker
	where
		maker_task_type != 'RC'
	order by
		task_pol_id desc

) init on
	init.task_pol_id = sbp.pol_id
left join sys_brk_users sbu_init on
	sbu_init.user_id = init.maker_id
left join (
	select
		distinct on
		(task_pol_id)

task_pol_id,
		checker_id
	from
		sys_brk_maker_checker
	order by
		task_pol_id desc

) auth on
	auth.task_pol_id = sbp.pol_id
left join sys_brk_users sbu on
	sbu.user_id = auth.checker_id
left join (
	select
		distinct on
		(sbmc_anp.task_pol_id)

sbmc_anp.task_pol_id,
		sbmc_rc.maker_id as rc_maker_id
	from
		sys_brk_maker_checker sbmc_anp
	inner join sys_brk_maker_checker sbmc_rc

on
		sbmc_anp.task_pol_id = sbmc_rc.task_pol_id
	where
		sbmc_anp.maker_task_type = 'ANP'
		and sbmc_rc.maker_task_type = 'RC'
	order by
		sbmc_anp.task_pol_id desc

) sbmc_rc_lookup on
	sbmc_rc_lookup.task_pol_id = sbp.pol_id
left join sys_brk_users sbu_rc on
	sbu_rc.user_id = sbmc_rc_lookup.rc_maker_id
left join (
	select
		MAX(alloc_paid_to_date) as alloc_paid_to_date,
		alloc_tran_no,
		MAX(alloc_install_no) as alloc_install_no,
		SUM(coalesce(alloc_life_whtx_amt, 0)) as alloc_life_whtx_amt,
		SUM(coalesce(alloc_comm_amt, 0)) as alloc_comm_amt,
		SUM(coalesce(alloc_marketer_comm_amt, 0)) as marketer_life_comm,
		SUM(coalesce(alloc_subagent_comm_amt, 0)) as subagent_life_comm,
		SUM(coalesce(alloc_admin_fee_amt, 0)) as life_admin_fee,
		SUM(coalesce(alloc_admin_fee_whtx_amt, 0)) as life_admin_fee_vat
	from
		sys_brk_life_rct_allocs
	group by
		alloc_tran_no

) att on
	tran_no = att.alloc_tran_no
where
	sbmt.trans_type not in ('RC', 'CN', 'SAG', 'RFC', 'RF', 'COM')
	and sbmt.trans_clnt_type not in ('IA', 'I')
	and sbmt.trans_date between DATE($P{dateFrom}) and DATE($P{dateTo}) + interval '1 day' - interval '1 second'
	and (sba.acct_id::varchar = $P{Agent}
		or $P{Agent} is null)
order by
	trans_date desc)

select
	*
from
	ranked_trans
where
	rn = 1
order by
	trans_date desc;]]>
	</queryString>
	<field name="org_mobile" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="org_mobile"/>
		<property name="com.jaspersoft.studio.field.label" value="org_mobile"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_organization"/>
	</field>
	<field name="org_address" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="org_address"/>
		<property name="com.jaspersoft.studio.field.label" value="org_address"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_organization"/>
	</field>
	<field name="org_phone" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="org_phone"/>
		<property name="com.jaspersoft.studio.field.label" value="org_phone"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_organization"/>
	</field>
	<field name="add_email_addr" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="add_email_addr"/>
		<property name="com.jaspersoft.studio.field.label" value="add_email_addr"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_organization"/>
	</field>
	<field name="org_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="org_name"/>
		<property name="com.jaspersoft.studio.field.label" value="org_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_organization"/>
	</field>
	<field name="org_website" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="org_website"/>
		<property name="com.jaspersoft.studio.field.label" value="org_website"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_organization"/>
	</field>
	<field name="trans_no" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="trans_no"/>
		<property name="com.jaspersoft.studio.field.label" value="trans_no"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_main_transactions"/>
	</field>
	<field name="trans_date" class="java.sql.Date">
		<property name="com.jaspersoft.studio.field.name" value="trans_date"/>
		<property name="com.jaspersoft.studio.field.label" value="trans_date"/>
	</field>
	<field name="trans_agent_code" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="trans_agent_code"/>
		<property name="com.jaspersoft.studio.field.label" value="trans_agent_code"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_main_transactions"/>
	</field>
	<field name="trans_pol_id" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="trans_pol_id"/>
		<property name="com.jaspersoft.studio.field.label" value="trans_pol_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_main_transactions"/>
	</field>
	<field name="client_id" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="client_id"/>
		<property name="com.jaspersoft.studio.field.label" value="client_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_clients"/>
	</field>
	<field name="client_idno" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="client_idno"/>
		<property name="com.jaspersoft.studio.field.label" value="client_idno"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_clients"/>
	</field>
	<field name="client_pin" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="client_pin"/>
		<property name="com.jaspersoft.studio.field.label" value="client_pin"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_clients"/>
	</field>
	<field name="client_fname" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="client_fname"/>
		<property name="com.jaspersoft.studio.field.label" value="client_fname"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_clients"/>
	</field>
