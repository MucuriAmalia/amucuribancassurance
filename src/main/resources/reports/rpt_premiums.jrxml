		<property name="com.jaspersoft.studio.field.label" value="pol_rev_no"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sys_brk_policies"/>
	</field>
	<field name="alloc_paid_to_date" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.name" value="alloc_paid_to_date"/>
		<property name="com.jaspersoft.studio.field.label" value="alloc_paid_to_date"/>
	</field>
	<field name="value_datee" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.name" value="value_datee"/>
		<property name="com.jaspersoft.studio.field.label" value="value_datee"/>
	</field>
	<field name="rn" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="rn"/>
		<property name="com.jaspersoft.studio.field.label" value="rn"/>
	</field>
	<variable name="Tot_Sum_Insured" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pol_sum_insur_amt}]]></variableExpression>
	</variable>
	<variable name="Tot_Basic_Premium" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pol_basic_premium_amt}]]></variableExpression>
	</variable>
	<variable name="Tot_Taxes" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{taxes}]]></variableExpression>
	</variable>
	<variable name="Tot_Other_Duties" class="java.lang.Double" calculation="Sum"/>
	<variable name="Tot_Commission" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pol_total_comm}]]></variableExpression>
	</variable>
	<variable name="Tot_W_TAX" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pol_total_whtx}]]></variableExpression>
	</variable>
	<variable name="Tot_Gross_Premium" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_premium}]]></variableExpression>
	</variable>
	<variable name="Tot_Premium_Paid" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{trans_settle_amt}]]></variableExpression>
	</variable>
	<variable name="Tot_Balance" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{balance}]]></variableExpression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="Tot_Sales_Agent_Commission" class="java.lang.Double" calculation="Sum"/>
	<variable name="Variable_1" class="java.lang.String"/>
	<variable name="sum_other_duties" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{trans_extras}]]></variableExpression>
	</variable>
	<variable name="Tot_StampDuties" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pol_stamp_duty}]]></variableExpression>
	</variable>
	<variable name="balance" class="java.math.BigDecimal">
		<variableExpression><![CDATA[(
  $F{gross_premium} == null
    ? java.math.BigDecimal.ZERO
    : $F{gross_premium}
).subtract(
  $F{trans_settle_amt} == null
    ? java.math.BigDecimal.ZERO
    : $F{trans_settle_amt}
)]]></variableExpression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="comm_aging" class="java.lang.Integer">
		<variableExpression><![CDATA[$F{trans_balance}.doubleValue() != 0 
    ? (int)((new java.util.Date().getTime() - $F{trans_date}.getTime()) / (1000 * 60 * 60 * 24)) 
    : null]]></variableExpression>
	</variable>
	<variable name="commision_againg_category" class="java.lang.String">
		<variableExpression><![CDATA[IF($V{comm_aging} > 90, "Over 90 Days", 
  IF($V{comm_aging} > 60, "61 - 90 Days", 
    IF($V{comm_aging} > 30, "31 - 60 Days", "Current")))]]></variableExpression>
	</variable>
	<variable name="tot_sub_agent" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{sub_agent_comm}]]></variableExpression>
	</variable>
	<variable name="tot_marketer_comm" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pol_marketer_agent_amt}]]></variableExpression>
	</variable>
