	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.Object"/>
	<queryString>
		<![CDATA[select distinct on (sbr.receipt_no)
sbr.receipt_date,sbr.receipt_no,sbr.receipt_paid_by,sbr.receipt_amount,pol_id,sbr.receipt_payment_ref,
sbr.receipt_amt_words,sbr.receipt_desc,rect_narration,rect_amount,rect_endorse_no,pm_desc,ca_name,
pol_no,trans_balance,trans_ref_no,pm_sh_desc,client_fname || ' ' || client_onames AS client_name, 
sbu.user_name as authorizer,
sbu2.user_name as initiator,
sbmc.check_on_date as checkdate,sbmc.made_on_date as madeon, maker_task_type
from  sys_brk_policies sbp 
LEFT join sys_brk_maker_checker sbmc on sbmc.task_pol_id = sbp.pol_id
 join sys_brk_receipt_dtls sbrd on pol_id = sbrd.rect_pol_id 
inner join sys_brk_receipts sbr on sbrd.rect_receipt_no =sbr.receipt_id
left join sys_brk_payment_modes sbpm on pol_pmode_id = pm_id
left join sys_brk_collect_accts sbca on sbca.ca_pm_id   = sbpm.pm_id
left join  sys_brk_receipts sbr1 on sbr1.receipt_collect_id = sbca.ca_id 
left join sys_brk_main_transactions sbmt  on trans_pol_id = pol_id
left join sys_brk_users sbu on sbu.user_id = sbmc.checker_id
left join sys_brk_users sbu2 on sbu2.user_id = sbmc.maker_id
inner join sys_brk_clients on  trans_clnt_code = client_id
where trans_balance = 0
    AND sbmc.maker_task_type = 'RC'
AND sbr. receipt_date BETWEEN $P{dateFrom} AND $P{dateTo}]]>
	</queryString>
