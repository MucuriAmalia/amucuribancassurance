<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="receipt_partial" pageWidth="1900" pageHeight="411" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="381" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="0" isIgnorePagination="true" uuid="e0d718d6-aeff-4275-9b69-19e93ef0351b">
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Local Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="647"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="353"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="logo" class="java.lang.Object"/>
	<queryString>
		<![CDATA[select distinct on (sbr.receipt_no)
sbr.receipt_date,sbr.receipt_no,sbr.receipt_paid_by,sbr.receipt_amount,pol_id,sbr.receipt_payment_ref,trans_ref_no,
sbr.receipt_amt_words,sbr.receipt_desc,rect_narration,rect_amount,rect_endorse_no,pm_desc,ca_name,
sbp.pol_no,trans_balance,client_fname || ' ' || client_onames AS client_name,check_status
from  sys_brk_policies sbp 
 join sys_brk_receipt_dtls sbrd on pol_id = sbrd.rect_pol_id 
inner join sys_brk_receipts sbr on sbrd.rect_receipt_no = receipt_id
left join sys_brk_payment_modes sbpm on pol_pmode_id = pm_id
left join sys_brk_collect_accts sbca on sbca.ca_pm_id   = sbpm.pm_id
left join  sys_brk_receipts sbr1 on sbr1.receipt_collect_id = sbca.ca_id 
left join sys_brk_main_transactions sbmt  on trans_pol_id = sbp.pol_id
inner join sys_brk_clients on  trans_clnt_code = client_id
left join sys_brk_users on pol_created_user = user_id
left join sys_brk_maker_checker sbmc on sbmc.maker_id= user_id
where check_status != 'A'
and  maker_task_type = 'RC'
AND sbr.receipt_date BETWEEN $P{dateFrom} AND $P{dateTo}]]>
	</queryString>
