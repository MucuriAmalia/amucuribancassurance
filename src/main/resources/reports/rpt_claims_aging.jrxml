<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_claims_aging" pageWidth="3360" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1162" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="20" uuid="23a07438-245c-4eed-b6df-048a58b30f40">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="format" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DISTINCT
    sbsss.seg_name,
    sba.acct_name,
    sbb.ob_name,
    sbcb.clm_no,
    sbcb.clm_loss_desc,
    sbcb.clm_date,
    sbp.pol_no || ' / ' || COALESCE(sbp.pol_client_pol_no, 'N/A') AS policy_number,
    sbc.client_fname || ' ' || sbc.client_onames AS client_names,
    sbc.client_idno,
    sbp2.prs_fname || ' ' || sbp2.prs_onames AS prospect_names,
    sbpg.bpg_desc,
    CASE
        WHEN sbpg.bpg_desc = 'LIFE' THEN COALESCE(sbc.client_idno, '')
        WHEN sbpg.bpg_desc = 'GENERAL INSURANCE' THEN COALESCE(sbr.risk_sht_desc, '')
        ELSE ''
    END AS risk_identifier,
    sbcb.clm_booked_dt,
    sbcb.clm_loss_date,
    sbc2.ca_desc,
    sbu.user_name,
    sbp4.p_desc,
    EXTRACT(DAY FROM (NOW() - sbcb.clm_date)) AS age_in_days,
    CASE 
        WHEN EXTRACT(DAY FROM (NOW() - sbcb.clm_date)) BETWEEN 0 AND 30 THEN 'current'
        WHEN EXTRACT(DAY FROM (NOW() - sbcb.clm_date)) BETWEEN 31 AND 60 THEN 'under pay'
        WHEN EXTRACT(DAY FROM (NOW() - sbcb.clm_date)) BETWEEN 61 AND 90 THEN 'over pay'
        ELSE 'over 90'
    END AS clm_status,
    COALESCE(sbcp.clm_prl_paid_amount, 0) AS clm_prl_paid_amount
FROM sys_brk_accounts sba
LEFT JOIN sys_brk_policies sbp ON sba.acct_id = sbp.pol_agent_id
LEFT JOIN sys_brk_risks sbr ON sbr.risk_pol_id = sbp.pol_id
INNER JOIN sys_brk_clm_bookings sbcb ON sbcb.clm_risk_id = sbr.risk_id
LEFT JOIN sys_brk_branches sbb ON sbb.ob_id = sbp.pol_branch_id
LEFT OUTER JOIN sys_brk_clients sbc ON sbc.client_id = sbr.risk_insured_id
LEFT OUTER JOIN sys_brk_prospects sbp2 ON sbp2.prs_id = sbp.pol_client_id
LEFT JOIN sys_brk_products sbp3 ON sbp3.pr_code = sbp.pol_prod_id
LEFT JOIN sys_brk_product_grp sbpg ON sbpg.bpg_code = sbp3.pr_bpg_code
LEFT JOIN sys_brk_users sbu ON sbu.user_id = sbcb.clm_booked_by
LEFT JOIN sys_brk_causations sbc2 ON sbc2.ca_id = sbcb.clm_status_id
LEFT JOIN sys_brk_clm_perils sbcp ON sbcp.clm_prl_clm_id = sbcb.clm_id
LEFT JOIN sys_brk_perils sbp4 ON sbp4.p_code = sbcp.clm_prl_peril_id
LEFT JOIN sys_brk_segments sbsss ON sbsss.seg_id = sbc.client_segment_code
WHERE CAST(sbp.pol_agent_id AS VARCHAR) = COALESCE($P{Agent}, CAST(sbp.pol_agent_id AS VARCHAR))
    AND CAST(sbcb.clm_date AS DATE) BETWEEN $P{dateFrom} AND $P{dateTo}]]>
	</queryString>
