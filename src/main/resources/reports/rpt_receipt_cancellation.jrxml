<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_sales" pageWidth="5280" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1902" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f295ff76-4097-4e7d-ae8a-2ef1703fc0f3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Local Adapter"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="747"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="242"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="SubAgent" class="java.lang.String"/>
	<parameter name="Introducer" class="java.lang.String"/>
	<parameter name="Marketer" class="java.lang.String"/>
	<parameter name="Branch" class="java.lang.String"/>
	<parameter name="Region" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
	org_mobile,org_address,org_phone,add_email_addr,org_name,org_website,
	sbmt.trans_no,
	sbmt.trans_date:: date AS trans_date,
	sbc.client_id,
	sbc.client_idno,
	sbc.client_pin,
	sbc.client_fname ,
	sbc.client_onames,
	sbc.client_cif,
	sbrs.sector_name as segment,
	sba.acct_name,
	sbp.pol_no,
	sbp.pol_client_pol_no as pol_client_pol_no,
	sbmt.trans_ref_no ,
	sbr.risk_sht_desc risk_sht_desc,
 EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) AS age_in_days,
        CASE 
        WHEN EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) BETWEEN 0 AND 30 THEN 'current'
        WHEN EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) BETWEEN 31 AND 60 THEN 'under pay'
        WHEN EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) BETWEEN 61 AND 90 THEN 'over pay'
        ELSE 'over 90'
    END AS payment_status,
    	sbp.pol_cover_to, 
	sbp.pol_cover_from, 
	case 
when sbmt.trans_type ='ADJ' 
then 'JOURNALS'
	when trans_type ='APC'
	then 'CANCELLATION'
	when trans_type ='APD' and pol_trans_type = 'EX'
	then 'EXTENSION'
	when trans_type ='APD' and pol_trans_type = 'EN'
	then 'ENDORSEMENT'
	when trans_type ='BNK'
	then 'BANK CHARGES'
	when trans_type ='CFO' and pol_trans_type = 'JVC'
	then 'CLAIM PAYMENT BY JOURNAL'
	when trans_type ='CFO' and pol_trans_type = 'CF'
	then 'CLAIM FEE'
	when trans_type ='CO' and pol_trans_type = 'CO'
	then 'CONTRA'
	when trans_type ='CO' and pol_trans_type = 'PM'
	then 'PAYMENTS'
	when trans_type ='COM' 
	then 'COMMISSION POSTING'
	when trans_type ='CPO' 
	then 'CLAIM PAYMENT'
	when trans_type ='CRI' 
	then 'CLAIM RECOVERY'
	when trans_type ='CRI' 
	then 'CLAIM SALVAGE'
	when trans_type ='DED' 
	then 'DECLARATION'
	when trans_type ='LOP' 
	then 'CLAIM OPENING'
	when trans_type ='LRV' and pol_trans_type = 'RP'
	then 'CLAIM REOPENING'
	when trans_type ='LRV' and pol_trans_type = 'LR'
	then 'CLAIM REVISION'
	when trans_type ='MEC' 
	then 'MID TERM ENDORSEMENT'
	when trans_type ='NBD'
	then 'NEW BUSINESS'
	when trans_type ='RC'
	then 'RECEIPTS'
	when trans_type ='RED'
	then 'REINSTATEMENT OF A POLICY' 
	when trans_type ='RFC'
	then 'REFUND'
	when trans_type ='RII'
	then 'REINSURANCE TRANSACTION'
	when trans_type ='NBC' and pol_trans_type = 'CO'
	then 'Reversal'
	when trans_type ='RND' and pol_trans_type != 'CO'
	then 'RENEWAL'
	when trans_type ='SPD' 
	then 'SHORT PERIOD'
	when trans_type ='CN'
	then 'Receipt Cancellation' 
	when trans_type ='APD' and pol_trans_type != 'CO'
	then 'Additional Premium'
	when trans_type ='APC' and pol_trans_type != 'CO'
	then 'Refund Premium'
	when pol_trans_type = 'CO'
	then 'Reversal'
	when trans_type = 'BUD'
    then 'BULK UPLOAD'
end  as  trans_type,
	sp.pr_desc,
	CASE 
        WHEN sbrg.bpg_desc = 'LIFE' THEN 'LONG TERM' 
        ELSE 'SHORT TERM'
    END AS insurance_type,
    sbrg.bpg_type,
    sbc2.cov_desc,
    coalesce (sbp.pol_total_sum_insured, 0) as pol_total_sum_insured,
    coalesce(sbp.pol_sum_insur_amt, 0) as pol_sum_insur_amt,
    COALESCE(sbp.pol_tot_train_levy,0) + COALESCE(sbp.pol_tot_phcf,0) AS taxes,
    COALESCE(sbmt.trans_settle_amt,0) AS trans_settle_amt,
	CASE 
	    WHEN bpg_type = 'L' THEN COALESCE(alloc_comm_amt, 0) 
	    ELSE COALESCE(ABS(sbp.pol_total_comm), 0) 
	END AS pol_total_comm,
   	pol_basic_premium_amt AS gross_premium,
    coalesce (sbp.pol_total_whtx, 0) as pol_total_whtx,
    coalesce (sbmt.trans_amount, 0) as basic_premium,
    coalesce (sbmt.trans_balance, 0) as trans_balance,
    coalesce (sbmt.trans_extras, 0) as trans_extras,
    sbu.user_name,
    sbbs.cl_desc,
    sba.acct_id,
    CASE 
        WHEN sbp.pol_total_comm = 0 THEN 0 
        ELSE ABS(sbp.pol_sub_agent_amt) 
    END AS sub_agent_comm,
    CASE 
        WHEN sbp.pol_total_comm = 0 THEN 0 
        ELSE COALESCE(sbp.pol_marketer_agent_amt, 0) 
    END AS pol_marketer_agent_amt,
    coalesce (sbp.pol_introducer_agent_amt, 0) as pol_introducer_agent_amt,
    sba3.acct_name as sub_acct_name,
    sba3.acct_sht_desc as sub_acct_code,
    sba1.acct_sht_desc as introducer_code,
    sba2.acct_sht_desc as marketer_code, 
    sba1.acct_name as introducer_name, 
    sba2.acct_name as marketer_name,
    coalesce (sbp.pol_introducer_agent_amt,0) as pol_introducer_agent_amt,
    coalesce (sbp.pol_marketer_agent_amt, 0) as pol_marketer_agent_amt,
    COALESCE(pol_stamp_duty, 0) AS pol_stamp_duty, sbre.reg_desc,
    sbb.ob_name, sbsg.seg_name, sbu.user_absa_no,
    sbu.user_name as initiator_name,
  bpg_desc, sp.pr_sap_code
FROM sys_brk_organization,sys_brk_main_transactions sbmt 
INNER JOIN sys_brk_clients AS sbc ON sbc.client_id = sbmt.trans_clnt_code
INNER JOIN sys_brk_policies AS sbp ON sbp.pol_id = sbmt.trans_pol_id
INNER JOIN sys_brk_accounts AS sba ON sba.acct_id = sbp.pol_agent_id
INNER JOIN sys_brk_risks AS sbr on sbr.risk_pol_id = sbp.pol_id 
INNER JOIN sys_brk_products AS sp ON sp.pr_code = sbp.pol_prod_id
INNER JOIN sys_brk_product_grp AS sbrg ON sbrg.bpg_code = sp.pr_bpg_code
INNER JOIN sys_brk_covertypes sbc2 on sbc2.cov_id = sbr.risk_cover_id
INNER JOIN sys_brk_users AS sbu ON sbu.user_id = sbp.pol_created_user 
inner join sys_brk_prod_subcls as sps on sps.ps_pr_code = sp.pr_code
inner join sys_brk_subclasses as sbs on sbs.sub_id = sps.ps_sub_code
inner join sys_brk_classes as sbbs on sbbs.cl_id = sbs.sub_cl_code
inner join sys_brk_account_types as sbat on sbat.acc_id = sba.acct_acc_code
left join sys_brk_accounts sba1 on sba1.acct_id = sbp.pol_introducer_agent_id
left join sys_brk_accounts sba2 on sba2.acct_id =  sbp.pol_marketer_agent_id
left join sys_brk_sectors as sbrs on sbrs.sector_id = sbc.client_sector_id 
left join sys_brk_accounts sba3 on sba3.acct_id =  sbp.pol_sub_agent_id
left join sys_brk_branches sbb on sbb.ob_id = sbp.pol_branch_id
left join sys_brk_regions sbre on sbre.reg_code = sbb.ob_reg_code
left join sys_brk_segments sbsg on sbsg.seg_id = sbc.client_segment_code
left join sys_brk_trans sbt on trans_tran_no = tran_no
left join sys_brk_life_rct_allocs on tran_no = alloc_tran_no
WHERE sbmt.trans_type = 'CN'
--and sbmt.trans_balance = 0
and sbp.pol_cover_from <= NOW() 
AND sbmt.trans_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second'
AND ( ($P{Agent} IS NULL) OR (sba.acct_id::varchar = $P{Agent}::varchar))
AND (($P{Branch} IS NULL) OR (sbb.ob_id::varchar = $P{Branch}::varchar))
AND (($P{Region} IS NULL) OR (sbre.reg_code::varchar = $P{Region}::varchar))
AND (($P{Introducer} IS NULL) OR (sba1.acct_id::varchar = $P{Introducer}::varchar))
AND (($P{Marketer} IS NULL) OR (sba2.acct_id::varchar = $P{Marketer}::varchar))
AND (($P{SubAgent} IS NULL) OR (sba3.acct_id::varchar = $P{SubAgent}::varchar))
order by trans_date desc;]]>
	</queryString>
