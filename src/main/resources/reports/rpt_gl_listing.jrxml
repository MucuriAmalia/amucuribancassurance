	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="asAtDate" class="java.util.Date"/>
	<parameter name="accountNo" class="java.lang.String"/>
	<parameter name="format" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    sbcs.co_code, 
    sbcs.co_name, 
    sbgt.gl_month, 
    sbgt.gl_year, 
    sbgt.gl_amount, 
    sbgt.gl_auth_date,
    CASE 
        WHEN sbgt.gl_dc = 'C' THEN 'Credit'
        WHEN sbgt.gl_dc = 'D' THEN 'Debit'
        ELSE sbgt.gl_dc 
    END AS gl_dc,
    CASE
    WHEN  sbgt.gl_trans_type = 'COMM' THEN 'Commission'
    WHEN  sbgt.gl_trans_type = 'WHTX' THEN 'Withholding Tax'
    WHEN  sbgt.gl_trans_type = 'PREM' THEN 'Premium'
    WHEN sbgt.gl_trans_type = 'RCPREM' THEN 'Receipt Premium'
    ELSE   sbgt.gl_trans_type
   END AS  gl_trans_type, pol_no, pr_desc, sba.acct_name, sbc.client_fname , sbc.client_onames,
   case when sbp.pol_business_type = 'L'
   then trans_lf_endors_no
   else sbp.pol_rev_no
   end as pol_rev_no,
   case when sbp.pol_business_type = 'L'
   then trans_ref_no
   else sbp.pol_ref_no
   end as risk_note_number
FROM sys_brk_gl_trans sbgt
INNER JOIN sys_brk_coa_sub sbcs ON sbcs.co_id = sbgt.gl_account
left join sys_brk_policies sbp on pol_id = gl_policy_trans_id 
left join sys_brk_main_transactions sbmt on sbgt.gl_main_trans_no = sbmt.trans_no
left join sys_brk_products on pr_code = pol_prod_id
left join sys_brk_accounts sba  on acct_id = pol_agent_id
left join sys_brk_clients sbc on client_id = pol_client_id
where date_trunc('day', gl_auth_date) <= $P{asAtDate}
and sbgt.gl_year = EXTRACT(YEAR FROM CURRENT_DATE)
AND (($P{accountNo} IS NULL) OR (sbcs.co_code::varchar = $P{accountNo}::varchar))
order by gl_auth_date desc;]]>
	</queryString>
