	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select due_date , install_paid,sbp.pol_basic_premium_amt,paid_date 
from sys_brk_life_installments sbli 
inner join sys_brk_policies sbp  on sbp.pol_id =sbli.lrct_policy_id 
where sbp.pol_id =  $P{polId}
ORDER BY due_date asc]]>
	</queryString>
