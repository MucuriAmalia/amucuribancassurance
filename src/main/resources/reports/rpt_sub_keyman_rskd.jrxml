	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select k."BUSINESS/OCCUPATION", k."NO. OF PERSONS", k."CATEGORY", k."NO"
from "KEYMAN" k 
inner join sys_brk_risks sbr on sbr.risk_id = k.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
