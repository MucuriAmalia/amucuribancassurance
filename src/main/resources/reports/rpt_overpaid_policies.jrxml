<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_policy_register" pageWidth="1050" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="962" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="20" uuid="23a07438-245c-4eed-b6df-048a58b30f40">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="absa_insurance"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="Agent" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT org_name, org_mobile, org_phone,
         org_address, org_website, phy_address, add_email_addr,
pol_no,
       pol_cover_to,
       client_fname,
       client_onames,
       pol_basic_premium_amt,
       pol_business_type,
       SUM(COALESCE(rd.rect_amount, 0)) AS total_receipts,
       SUM(COALESCE(li.install_prem, 0)) AS total_life_inst,
       -- Add refund premium calculation (for example: refund_premium is calculated by subtracting total receipts from basic premium or installment)
       CASE
           WHEN p.pol_business_type = 'N'
               THEN SUM(COALESCE(rd.rect_amount, 0)) - COALESCE(p.pol_basic_premium_amt, 0)
           WHEN p.pol_business_type = 'L'
               THEN SUM(COALESCE(rd.rect_amount, 0)) - SUM(COALESCE(li.install_prem, 0))
           ELSE 0
           END AS refund_premium
from sys_brk_organization sbo , sys_brk_policies p
         INNER JOIN sys_brk_clients c ON p.pol_client_id = c.client_id
         LEFT JOIN sys_brk_receipt_dtls rd ON p.pol_id = rd.rect_pol_id
         LEFT JOIN sys_brk_receipts r ON rd.rect_receipt_no = r.receipt_id
         LEFT JOIN sys_brk_life_rcts lr ON rd.rect_receipt_no = lr.lrct_receipt_id
         LEFT JOIN sys_brk_life_installments li ON p.pol_id = li.lrct_policy_id
WHERE (
    (pol_wet_date BETWEEN $P{dateFrom} AND $P{dateTo})
    OR (pol_wef_date BETWEEN $P{dateFrom} AND $P{dateTo})
    OR (r.receipt_date BETWEEN $P{dateFrom} AND $P{dateTo})
    OR (lr.receipt_date BETWEEN $P{dateFrom} AND $P{dateTo})
)
  AND (pol_agent_id::varchar = $P{Agent} OR  $P{Agent} IS NULL)
GROUP BY client_onames, client_fname, pol_no, pol_basic_premium_amt, pol_business_type, pol_cover_to, org_name, org_mobile, org_phone,
         org_address, org_website, phy_address, add_email_addr
HAVING
    -- General policies: ensure that the refund premium is greater than or equal to 1
    (p.pol_business_type = 'N' AND (SUM(COALESCE(rd.rect_amount, 0)) - COALESCE(p.pol_basic_premium_amt, 0)) >= 1)

    -- Life policies: ensure that the refund premium is greater than or equal to 1
    OR (p.pol_business_type = 'L' AND (SUM(COALESCE(rd.rect_amount, 0)) - SUM(COALESCE(li.install_prem, 0)) >= 1))
ORDER BY pol_no DESC;]]>
	</queryString>
