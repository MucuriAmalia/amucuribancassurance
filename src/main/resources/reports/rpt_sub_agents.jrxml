<jasperReport name="SubAgentsReport" language="java" pageWidth="650" pageHeight="842" columnWidth="580" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="eb84e915-4aa6-4eb9-92b3-e6b12c6e140a">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="ACCOUNT_TYPE" class="java.lang.String">
		<defaultValueExpression><![CDATA["Sub Agents"]]></defaultValueExpression>
	</parameter>
	<parameter name="ACCOUNT_TYPE_CODE" evaluationTime="Early" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{ACCOUNT_TYPE} == null ? "SUB" : ($P{ACCOUNT_TYPE}.equals("Introducer") ? "INT" : ($P{ACCOUNT_TYPE}.equals("Marketer") ? "MKT" : ($P{ACCOUNT_TYPE}.equals("Sub Agents") ? "SUB" : "SUB")))]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_DATE" forPrompting="false" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    a.acct_name AS name,
    a.acct_absa_no AS ab_no,
    a.acct_pin AS pin_no,
    a.acct_phone AS phone_no,
    b.ob_name AS branch, -- Changed from bb_name to ob_name
    a.acct_brn_code AS branch_code,
    t.acc_type AS account_type,
    a.acct_status AS status,
    a.acct_comm_earning AS acct_comm_earning
FROM sys_brk_accounts a
JOIN sys_brk_account_types t ON a.acct_acc_code = t.acc_id
LEFT JOIN sys_brk_branches b ON a.acct_brn_code = b.ob_id
WHERE t.acc_type = $P{ACCOUNT_TYPE_CODE}
ORDER BY a.acct_name]]></query>
