<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_clients_translist" pageWidth="2522" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1202" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isTitleNewPage="true" uuid="f295ff76-4097-4e7d-ae8a-2ef1703fc0f3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Local Adapter"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="clientid" class="java.lang.String">
		<parameterDescription><![CDATA[Client Identifier]]></parameterDescription>
	</parameter>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT distinct client_sht_desc,pol_prod_id,pr_desc,risk_sht_desc,risk_pol_id,
trans_no,trans_ref_no,trans_date,trans_pol_id,pol_client_pol_no "policy",pol_no,client_fname || ' ' || client_onames AS client_name,
trans_control_acc,trans_dc,trans_amount, trans_comm, 
trans_balance,pol_net_premium_amt,trans_whtx,trans_clnt_type,
pol_basic_premium_amt as gross_premium,
COALESCE(trans_extras, 0) AS trans_extras,
COALESCE(trans_sd, 0) AS trans_sd,
COALESCE(trans_tl, 0) AS trans_tl,
COALESCE(trans_phfund, 0) AS trans_phfund,
CASE 
	    WHEN bpg_type = 'L' THEN COALESCE(alloc_comm_amt, 0) 
	    ELSE COALESCE(ABS(sbp.pol_total_comm), 0) 
	END AS pol_total_comm,
     COALESCE(trans_settle_amt, 0) AS trans_settle_amt,
     coalesce (pol_total_prem, 0) as basic_premium,
case 
when sbmt.trans_type ='ADJ' 
then 'JOURNALS'
when sbmt.trans_type ='SAG' 
then 'Sub-Agent Commission'
	when trans_type ='APC'
	then 'CANCELLATION'
	when trans_type ='APD' and pol_trans_type = 'EX'
	then 'EXTENSION'
	when trans_type ='APD' and pol_trans_type = 'EN'
	then 'ENDORSEMENT'
	when trans_type ='BNK'
	then 'BANK CHARGES'
	when trans_type ='CFO' and pol_trans_type = 'JVC'
	then 'CLAIM PAYMENT BY JOURNAL'
	when trans_type ='CFO' and pol_trans_type = 'CF'
	then 'CLAIM FEE'
	when trans_type ='CO' and pol_trans_type = 'CO'
	then 'CONTRA'
	when trans_type ='CO' and pol_trans_type = 'PM'
	then 'PAYMENTS'
	when trans_type ='COM' 
	then 'COMMISSION POSTING'
	when trans_type ='CPO' 
	then 'CLAIM PAYMENT'
	when trans_type ='CRI' 
	then 'CLAIM RECOVERY'
	when trans_type ='CRI' 
	then 'CLAIM SALVAGE'
	when trans_type ='DED' 
	then 'DECLARATION'
	when trans_type ='LOP' 
	then 'CLAIM OPENING'
	when trans_type ='LRV' and pol_trans_type = 'RP'
	then 'CLAIM REOPENING'
	when trans_type ='LRV' and pol_trans_type = 'LR'
	then 'CLAIM REVISION'
	when trans_type ='MEC' 
	then 'MID TERM ENDORSEMENT'
	when trans_type ='NBD'
	then 'NEW BUSINESS'
	when trans_type ='RC'
	then 'RECEIPTS'
	when trans_type ='RED'
	then 'REINSTATEMENT OF A POLICY' 
	when trans_type ='RFC'
	then 'REFUND'
	when trans_type ='RII'
	then 'REINSURANCE TRANSACTION'
	when trans_type ='NBC' and pol_trans_type = 'CO'
	then 'Reversal'
	when trans_type ='RND' and pol_trans_type != 'CO'
	then 'RENEWAL'
	when trans_type ='SPD' 
	then 'SHORT PERIOD'
	when trans_type ='CN'
	then 'Receipt Cancellation' 
	when trans_type ='APD' and pol_trans_type != 'CO'
	then 'Additional Premium'
	when trans_type ='APC' and pol_trans_type != 'CO'
	then 'Refund Premium'
	when pol_trans_type = 'CO'
	then 'Reversal'
	when trans_type = 'BUD'
    then 'BULK UPLOAD'
end  as  trans_type,
sbp.pol_client_pol_no as pol_client_pol_no
from sys_brk_organization,sys_brk_main_transactions  sbmt
inner join sys_brk_policies sbp on pol_id = trans_pol_id
inner join sys_brk_clients on client_id = trans_clnt_code
left join sys_brk_products sp on pr_code = pol_prod_id
INNER JOIN sys_brk_product_grp AS sbrg ON sbrg.bpg_code = sp.pr_bpg_code
left  join sys_brk_risks on  pol_id= risk_pol_id
left join sys_brk_trans sbt on trans_tran_no = tran_no
left join sys_brk_life_rct_allocs on tran_no = alloc_tran_no
where trans_authorised = 'Y'
and trans_clnt_type = 'C'
and trans_type != 'RC'
and   (client_id::varchar)  =  COALESCE($P{clientid} ,(client_id::varchar))
AND trans_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second'
order by client_name,trans_date DESC]]>
	</queryString>
