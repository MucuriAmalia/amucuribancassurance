<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_claims_daily_report" pageWidth="1955" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1915" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="0e77c0ed-835f-4c0d-9587-6db88c6fe371">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="absaa"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="302"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="691"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="597"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="393"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false">
		<defaultValueExpression><![CDATA[$P{logo}]]></defaultValueExpression>
	</parameter>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.sql.Date">
		<defaultValueExpression><![CDATA[new java.sql.Date(System.currentTimeMillis())]]></defaultValueExpression>
	</parameter>
	<parameter name="dateTo" class="java.sql.Date">
		<defaultValueExpression><![CDATA[new java.sql.Date(System.currentTimeMillis())]]></defaultValueExpression>
	</parameter>
	<parameter name="causation" class="java.lang.String">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
    cb.clm_no AS "Claim No",
    REPLACE(REPLACE(CONCAT(cl.client_fname, ' ', cl.client_onames), CHR(13), ' '), CHR(10), ' ') AS "Client",
    pol.pol_no AS "Policy Number",
    cb.clm_booked_dt AS "Booked Date",
    ca_act.clm_act_rem_dt AS "Reminder Date", 
    cb.clm_insurer_dt AS "Notification Date",
    REPLACE(REPLACE(ca.ca_desc, CHR(13), ' '), CHR(10), ' ') AS "Activity",
    cb.clm_loss_date AS "Loss Date",
    CASE
        WHEN UPPER(sbpg.bpg_desc) LIKE '%LIFE%' THEN COALESCE(cl.client_idno, 'MISSING_CLIENT_IDNO')
        ELSE COALESCE(rk.risk_sht_desc, 'MISSING_RISK_SHT_DESC')
    END AS "Risk Identifier",
    rk.risk_wef_date AS "Period From",
    rk.risk_wet_date AS "Period To",
    rk.risk_sum_insur_amt AS "Value",
    REPLACE(REPLACE(cl.client_sht_desc, CHR(13), ' '), CHR(10), ' ') AS "Insured"
FROM
    sys_brk_clm_bookings cb
JOIN
    sys_brk_risks rk ON cb.clm_risk_id = rk.risk_id
JOIN
    sys_brk_clients cl ON rk.risk_insured_id = cl.client_id
JOIN
    sys_brk_policies pol ON rk.risk_pol_id = pol.pol_id
JOIN
    sys_brk_products sbp3 ON pol.pol_prod_id = sbp3.pr_code
JOIN
    sys_brk_product_grp sbpg ON sbp3.pr_bpg_code = sbpg.bpg_code
INNER JOIN
    (SELECT
         clm_act_id,
         clm_act_clm_id,
         clm_act_status_id,
         clm_act_rem_dt,
         ROW_NUMBER() OVER (PARTITION BY clm_act_clm_id ORDER BY clm_act_dt DESC) AS rn
     FROM
         sys_brk_clm_activities
     WHERE
         clm_act_status_id IS NOT NULL
         AND clm_act_rem_dt BETWEEN $P{dateFrom} AND $P{dateTo}
    ) ca_act ON cb.clm_id = ca_act.clm_act_clm_id AND ca_act.rn = 1
INNER JOIN
    sys_brk_causations ca ON ca_act.clm_act_status_id = ca.ca_id
WHERE
    ($P{causation} IS NULL OR ca.ca_desc LIKE $P{causation})]]>
	</queryString>
