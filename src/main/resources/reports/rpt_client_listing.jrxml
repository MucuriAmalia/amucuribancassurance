<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_client_listing" pageWidth="2650" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="1455" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" uuid="1b49ce42-35ed-48c3-99c9-8e7331c9a53e">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Latest Adapter"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="Client" class="java.lang.String"/>
	<parameter name="format" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select  client_id,client_fname ||' '|| client_onames client_name,client_address,client_sht_desc,client_resident_status,sbc.client_brn_code, 
client_phone,client_email,client_sms_number,client_pin,client_idno,client_passport_no,client_segment_code,ob_name,
client_date_created::date,client_gender,sbc.client_created_user,sbs.seg_name,sbu.created_by, client_cif,
sbu.user_name,sbu.modified_by,sbu.modified_date::date,sbu.user_absa_no,
case when client_status='A' then 'Active'
else 'Inactive'
end as client_status
from sys_brk_clients sbc
inner join sys_brk_users sbu on sbu.user_id =sbc.client_created_user  
left join sys_brk_segments sbs on sbs.seg_id =sbc.client_segment_code 
inner join sys_brk_branches sbb on sbb.ob_id = sbc.client_brn_code 
where (client_id::varchar) = COALESCE( $P{Client},(client_id::varchar));]]>
	</queryString>
