	<queryString>
		<![CDATA[select distinct on (sc_sht_desc)
    sbpg.bpg_desc,
    sbp.pr_desc,
    sbc.sc_sht_desc AS premium_id,
    sbc.sc_desc AS premium_name,
    sba.acct_name,
    sba.acct_sht_desc
FROM sys_brk_sections sbc, sys_brk_products sbp 
left JOIN sys_brk_product_grp sbpg ON sbpg.bpg_code = sbp.pr_bpg_code
left join sys_brk_policies sbpp on sbpp.pol_prod_id = sbp.pr_code
left join sys_brk_accounts sba ON sba.acct_id = sbpp.pol_agent_id
order by sc_sht_desc;]]>
	</queryString>
