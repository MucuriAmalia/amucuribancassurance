	<parameter name="PolNo" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="Product" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    maker.user_name AS maker,
    checker.user_name AS checker,
    mc.made_on_date AS made_on_date,
    mc.check_on_date AS check_on_date,
    mc.task_name AS task,
    CASE 
        WHEN trans_type = 'RC' THEN 'RECEIPTS'
        WHEN trans_type = 'ADJ' THEN 'JOURNALS'
        WHEN trans_type = 'APC' THEN 'CANCELLATION DR NOTE'
        WHEN trans_type = 'CNC' THEN 'CANCELLATION CR NOTE'
        WHEN trans_type = 'APD' AND pol_trans_type = 'EX' THEN 'EXTENSION'
        WHEN trans_type = 'APD' AND pol_trans_type = 'EN' THEN 'ENDORSEMENT DR NOTE'
        WHEN trans_type = 'RPC' AND pol_trans_type = 'EN' THEN 'ENDORSEMENT CR NOTE'
        WHEN trans_type = 'BNK' THEN 'BANK CHARGES'
        WHEN trans_type = 'CFO' AND pol_trans_type = 'JVC' THEN 'CLAIM PAYMENT BY JOURNAL'
        WHEN trans_type = 'CFO' AND pol_trans_type = 'CF' THEN 'CLAIM FEE'
        WHEN trans_type = 'CO' AND pol_trans_type = 'CO' THEN 'CONTRA'
        WHEN trans_type = 'CO' AND pol_trans_type = 'PM' THEN 'PAYMENTS'
        WHEN trans_type = 'COM' THEN 'COMMISSION POSTING'
        WHEN trans_type = 'CPO' THEN 'CLAIM PAYMENT'
        WHEN trans_type = 'CRI' THEN 'CLAIM RECOVERY'
        WHEN trans_type = 'DED' THEN 'DECLARATION'
        WHEN trans_type = 'LOP' THEN 'CLAIM OPENING'
        WHEN trans_type = 'LRV' AND pol_trans_type = 'RP' THEN 'CLAIM REOPENING'
        WHEN trans_type = 'LRV' AND pol_trans_type = 'LR' THEN 'CLAIM REVISION'
        WHEN trans_type = 'MEC' THEN 'MID TERM ENDORSEMENT'
        WHEN trans_type = 'NBD' THEN 'NEW BUSINESS'
        WHEN trans_type = 'RED' THEN 'REINSTATEMENT'
        WHEN trans_type = 'RFC' THEN 'REFUND'
        WHEN trans_type = 'RF' THEN 'REFUND'
        WHEN trans_type = 'RII' THEN 'REINSURANCE TRANSACTION'
        WHEN trans_type = 'NBC' AND pol_trans_type = 'CO' THEN 'REVERSAL'
        WHEN trans_type = 'RND' AND pol_trans_type != 'CO' THEN 'RENEWAL'
        WHEN trans_type = 'SPD' THEN 'SHORT PERIOD'
        WHEN trans_type = 'CN' THEN 'RECEIPT CANCELLATION'
        WHEN trans_type = 'APD' AND pol_trans_type != 'CO' THEN 'ADDITIONAL PREMIUM'
        WHEN trans_type = 'APC' AND pol_trans_type != 'CO' THEN 'REFUND PREMIUM'
        WHEN pol_trans_type = 'CO' THEN 'REVERSAL'
        WHEN trans_type = 'BUD' THEN 'BULK UPLOAD'
        WHEN trans_type = 'SAG' THEN 'SUB AGENT COMMISSION'
        ELSE trans_type
    END AS tran_desc,
    sbc.client_fname,
    sbc.client_onames,
    pol_no
FROM sys_brk_maker_checker mc
LEFT JOIN sys_brk_policies pol ON mc.task_pol_id = pol.pol_id
LEFT JOIN sys_brk_users maker ON mc.maker_id = maker.user_id
LEFT JOIN sys_brk_users checker ON mc.checker_id = checker.user_id
LEFT JOIN sys_brk_main_transactions trans ON trans.trans_pol_id = pol.pol_id
LEFT JOIN sys_brk_accounts acct ON pol.pol_agent_id = acct.acct_id
LEFT JOIN sys_brk_products prod ON pol.pol_prod_id = prod.pr_code
LEFT JOIN sys_brk_clients sbc ON pol.pol_client_id = sbc.client_id
WHERE (($P{Client} IS NULL) OR (sbc.client_id::varchar = $P{Client}::varchar))
AND (($P{PolNo} IS NULL) OR (pol.pol_id::varchar = $P{PolNo}::varchar))
AND (($P{Product} IS NULL) OR (prod.pr_desc::varchar = $P{Product}::varchar))
AND mc.made_on_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second']]>
	</queryString>
