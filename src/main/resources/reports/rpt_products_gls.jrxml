<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_products" pageWidth="1440" pageHeight="595" whenNoDataType="BlankPage" columnWidth="660" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1bf9c828-381b-4849-8fb8-dac124bc168d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="data latest adapter"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="879"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="110"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="Product" class="java.lang.String"/>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="format" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select acct_name, acct_id, pr_code, pr_desc, pr_sap_code, rev_cr_account, rev_dr_account, debit, debit_code, credit, credit_code,
acct_debit_code, acct_debit_name, acct_credit_code, acct_credit_name, whtx_debit_code, whtx_debit_name, whtx_credit_code,whtx_credit_name,
admin_debit_code, admin_debit_name,comm_debit_code,comm_debit_name, revenue_description
from (
SELECT DISTINCT
NULL AS acct_name,
null:: bigint AS acct_id,
NULL::bigint AS pr_code,
NULL AS pr_desc,
null::bigint AS pr_sap_code,
sbri.rev_cr_account,
sbri.rev_dr_account,
sbcs.co_name AS debit,
sbcs.co_code AS debit_code,
sbcs1.co_name AS credit,
sbcs1.co_code AS credit_code,
null as acct_debit_code,
null as acct_debit_name,
null as acct_credit_code,
null as acct_credit_name,
null as whtx_debit_code,
null as whtx_debit_name,
null as whtx_credit_code,
null as whtx_credit_name,
null as admin_debit_code,
null as admin_debit_name,
null as comm_debit_code,
null as comm_debit_name,
CASE
WHEN sbri.rev_code = 'SAC' THEN 'Sub Agent Commission'
WHEN sbri.rev_code = 'NR' THEN 'Commission Receipts'
END AS revenue_description
FROM sys_brk_revenue_items sbri
LEFT JOIN sys_brk_coa_sub sbcs ON sbcs.co_id = sbri.rev_dr_account
LEFT JOIN sys_brk_coa_sub sbcs1 ON sbcs1.co_id = sbri.rev_cr_account
WHERE sbri.rev_code IN ('NR', 'SAC')
	UNION ALL
SELECT distinct
sba.acct_name,
sba.acct_id,
sbp.pr_code,
sbp.pr_desc,
sbp.pr_sap_code,
sbri.rev_cr_account,
sbri.rev_dr_account,
sbcs.co_name AS debit,
sbcs.co_code AS debit_code,
sbcs1.co_name AS credit,
sbcs1.co_code AS credit_code,
sbcs2.co_code as acct_debit_code,
sbcs2.co_name as acct_debit_name,
sbcs3.co_code as acct_credit_code,
sbcs3.co_name as acct_credit_name,
sbcs4.co_code as whtx_debit_code,
sbcs4.co_name as whtx_debit_name,
sbcs5.co_code as whtx_credit_code,
sbcs5.co_name as whtx_credit_name,
sbcs6.co_code as admin_debit_code,
sbcs6.co_name as admin_debit_name,
sbcs7.co_code as comm_debit_code,
sbcs7.co_name as comm_debit_name,
CASE
WHEN sbri.rev_code = 'SAC' THEN 'Sub Agent Commission'
WHEN sbri.rev_code = 'UC' THEN 'Underwriting Commission'
WHEN sbri.rev_code = 'AF' THEN 'Admin Fee'
END AS revenue_description
FROM sys_brk_revenue_items sbri
LEFT JOIN sys_brk_coa_sub sbcs ON sbcs.co_id = sbri.rev_dr_account
LEFT JOIN sys_brk_coa_sub sbcs1 ON sbcs1.co_id = sbri.rev_cr_account
LEFT JOIN sys_brk_subclasses sbs ON sbs.sub_id = sbri.rev_sub_id
LEFT JOIN sys_brk_classes sbc ON sbc.cl_id = sbs.sub_cl_code
LEFT JOIN sys_brk_prod_subcls sbps ON sbps.ps_sub_code = sbs.sub_id
INNER JOIN sys_brk_products sbp ON sbp.pr_code = sbps.ps_pr_code
LEFT JOIN sys_brk_binders sbd ON sbd.bin_pr_code = sbp.pr_code
LEFT JOIN sys_brk_accounts sba ON sba.acct_id = sbd.bin_acct_code
LEFT JOIN sys_brk_coa_main sbcm ON sbcm.co_id = sbcs.co_main_acc_id
LEFT JOIN sys_brk_coa_sub sbcs2 ON sbcs2.co_id = sba.acct_receivable_acct
LEFT JOIN sys_brk_coa_sub sbcs3 ON sbcs3.co_id = sba.acct_payable_acct
LEFT JOIN sys_brk_coa_sub sbcs4 ON sbcs4.co_id = sba.acct_whtx_acct 
LEFT JOIN sys_brk_coa_sub sbcs5 ON sbcs5.co_id = sba.acct_pay_whtx_acct 
LEFT JOIN sys_brk_coa_sub sbcs6 ON sbcs6.co_id = sba.acct_admin_acct
LEFT JOIN sys_brk_coa_sub sbcs7 ON sbcs7.co_id = sba.acct_comm_acct
WHERE sba.acct_acc_code = 1
AND sbri.rev_code IN ('UC', 'AF')
AND (($P{Product} IS NULL) OR (sbp.pr_code::varchar = $P{Product}::varchar))
AND (($P{Agent} IS NULL) OR (sba.acct_id::varchar = $P{Agent}::varchar))
)
order by acct_name, pr_desc]]>
	</queryString>
