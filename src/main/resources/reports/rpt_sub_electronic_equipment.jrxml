	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "DESCRIPTION" , "INSURED " , "BUSINESS INTERRUPTION "  ,"MATERIAL DAMAGE"
from "ELECTRONIC EQUIPMENT" ei
inner join sys_brk_risks sbr on sbr.risk_id = ei.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
