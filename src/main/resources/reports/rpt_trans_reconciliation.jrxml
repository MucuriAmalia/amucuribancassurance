	<parameter name="riskNoteSearch" class="java.lang.String"/>
	<parameter name="reconStatus" class="java.lang.String"/>
	<parameter name="Agent" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT ON (recon_data_pol_risk_note_no) 
    recon_status, recon_data_pol_client, recon_data_pol_no,
    recon_data_pol_prem, recon_data_date, sbrd.recon_data_settlement, 
    sbrd.recon_data_balance, acct_name, sbrd.recon_underwriter_trans_code, 
    sbrd.recon_data_pol_underwriter_no, sbrd.recon_data_pol_risk_note_no
FROM sys_brk_trans_reconciliation sbr
JOIN sys_brk_trans_reconciliation_data sbrd ON sbrd.recon_data_id = sbr.recon_data_id
JOIN sys_brk_policies sbp ON sbp.pol_no = sbrd.recon_data_pol_no
JOIN sys_brk_accounts sba ON sba.acct_id = sbp.pol_agent_id
WHERE (($P{Agent} IS NULL) OR (sba.acct_id::varchar = $P{Agent}::varchar))
AND recon_data_date BETWEEN $P{dateFrom}::date AND $P{dateTo}::date
AND (($P{reconStatus} IS NULL) OR (LOWER(sbr.recon_status) = LOWER($P{reconStatus})))
AND (($P{riskNoteSearch} IS NULL) OR (LOWER(sbrd.recon_data_pol_risk_note_no) LIKE LOWER(CONCAT('%', $P{riskNoteSearch}, '%'))))
ORDER BY recon_data_pol_risk_note_no, recon_data_date DESC]]>
	</queryString>
