<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_claim_synopsis" pageWidth="920" pageHeight="842" columnWidth="765" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="116ba2e3-f64b-47ad-a401-c58172b6c593">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="absa"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="318"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="670"/>
	<import value="org.apache.commons.codec.binary.Base64"/>
	<parameter name="clmId" class="java.lang.Long"/>
	<parameter name="logo" class="java.lang.Object"/>
	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT on (s.clm_no)
    org_name, org_mobile, org_phone, org_address, org_website, phy_address, add_email_addr,
    s.clm_id,
    s3.client_fname, s3.client_onames, s5.pol_client_pol_no, s5.pol_no,
    s2.risk_sht_desc, s2.risk_desc, s2.risk_wef_date, s2.risk_wet_date,
    s.clm_no, s6.acct_name, s5.pol_sum_insur_amt,
    
    SUM(CASE WHEN s7.trans_dc = 'D' THEN s7.trans_balance END) AS Ins_bal,
    SUM(CASE WHEN s7.trans_dc = 'C' THEN s7.trans_balance END) * -1 AS client_bal,
    
    s8.pr_desc, s9.cov_desc, s.clm_loss_date, s.clm_time, s.clm_booked_dt, s.clm_insurer_dt,
    s.clm_next_rvw_dt, s.clm_status, s6.acct_contact_person, s6.acct_contact_title,
    s6.acct_email, s6.acct_phone,
    
    s4.user_name,
    s.clm_loss_desc,
    
    CASE WHEN clm_clmnt_tp = 'S' THEN s10.client_fname || ' ' || s10.client_onames END AS claimants,
    CASE WHEN clm_clmnt_tp = 'T' THEN s11.clmnt_othernames || ' ' || s11.clmnt_surname END AS oClaimants,
    
    s12.clm_prl_total_reserve AS claim_estimate,
(SELECT clm_act_insurer_ref 
 FROM sys_brk_clm_activities 
 WHERE clm_act_clm_id = s.clm_id 
 ORDER BY (CASE WHEN clm_act_insurer_ref IS NOT NULL THEN 0 ELSE 1 END)
 LIMIT 1) AS clm_act_insurer_ref,
    s.balance_approval_date,
    claim_approval_date,
    approver.user_name AS claim_approver

FROM sys_brk_organization,
    sys_brk_clm_bookings s
    left join sys_brk_clm_claimants s1 ON s.clm_id = s1.clm_clmnt_clm_id
    left join sys_brk_risks s2 ON s2.risk_id = s.clm_risk_id
    left join sys_brk_clients s3 ON s3.client_id = s2.risk_insured_id
    left join sys_brk_users s4 ON s4.user_id = s.clm_booked_by
    left JOIN sys_brk_users approver ON approver.user_id = s.claim_approved_by
    left join sys_brk_policies s5 ON s5.pol_id = s2.risk_pol_id
    left join sys_brk_accounts s6 ON s6.acct_id = s5.pol_agent_id
    left join sys_brk_main_transactions s7 ON s5.pol_id = s7.trans_pol_id
    left join sys_brk_products s8 ON s8.pr_code = s5.pol_prod_id
    left join sys_brk_covertypes s9 ON s9.cov_id = s2.risk_cover_id
    LEFT OUTER JOIN sys_brk_clients s10 ON s10.client_id = s1.clm_clmnt_client_id
    LEFT OUTER JOIN sys_brk_claimants s11 ON s11.clmnt_id = s1.clm_clmnt_clmnt_id
    left join sys_brk_clm_perils s12 ON s.clm_id = s12.clm_prl_clm_id
    LEFT JOIN sys_brk_clm_activities sbca ON sbca.clm_act_clm_id = s.clm_id

WHERE s.clm_id = $P{clmId}
    AND sbca.clm_act_insurer_ref IS NOT NULL

GROUP BY 
    s3.client_fname, s3.client_onames, s5.pol_client_pol_no, s2.risk_sht_desc, s2.risk_desc, s5.pol_no,
    s2.risk_wef_date, s2.risk_wet_date, s.clm_no, s6.acct_name, s5.pol_sum_insur_amt,
    s8.pr_desc, s9.cov_desc, s.clm_loss_date, s.clm_time, s.clm_booked_dt, s.clm_insurer_dt,
    s.clm_next_rvw_dt, s.clm_status, s6.acct_contact_person, s6.acct_contact_title,
    s6.acct_email, s6.acct_phone, s4.user_name, s.clm_loss_desc,
    claimants, oClaimants, s.clm_id,
    org_name, org_mobile, org_phone, org_address, org_website, phy_address, add_email_addr,
    s12.clm_prl_total_reserve, sbca.clm_act_insurer_ref,
    s.balance_approval_date, claim_approval_date, approver.user_name
    order by    s.clm_no
]]>
	</queryString>
