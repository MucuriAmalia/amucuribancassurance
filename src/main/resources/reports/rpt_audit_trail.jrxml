	<queryString language="SQL">
		<![CDATA[select sbal.id,sbal."action" ,sbal.details ,sbal.resource ,sbal."timestamp" ,sbal.username
from sys_brk_audit_logs sbal
where "timestamp" BETWEEN $P{dateFrom} AND $P{dateTo}
and (username = $P{User} OR $P{User} IS NULL)
order by "timestamp" desc]]>
	</queryString>
