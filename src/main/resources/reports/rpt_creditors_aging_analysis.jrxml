<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_debtors_aging" pageWidth="4010" pageHeight="595" orientation="Landscape" columnWidth="1802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5eee1643-e11d-4455-ae48-093811b06ac3">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Latest Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="247"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="746"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="545"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="444"/>
	<parameter name="balance" class="java.lang.String" isForPrompting="false"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="branch" class="java.lang.String"/>
	<parameter name="curr" class="java.lang.String"/>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="asOfDate" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT DISTINCT org_name,org_address,org_mobile,org_phone,add_email_addr,
org_website, ob_name,client_id,cnt_title,client_fname,client_onames,client_sht_desc,cur_iso_code,
pol_no,acct_name,COALESCE(pol_basic_premium_amt, 0) AS pol_basic_premium_amt,
  COALESCE(trans_settle_amt, 0) AS trans_settle_amt, sbmt.value_date,
client_sht_desc,cnt_type_desc ,sum(trans_balance) as bal,
COALESCE(sbp.pol_sum_insur_amt, 0) AS pol_sum_insur_amt,
  case when 'MOVING' = 'MOVING'  
         THEN
      sum(trans_balance)
          ELSE
      sum(trans_net_amt)
        END AS balance    ,
 SUM(CASE WHEN trans_type = 'RC' 
             THEN 
                 CASE WHEN trans_dc = 'C' 
                        THEN ABS(trans_balance)*-1 
                     WHEN trans_dc = 'D' 
                         THEN ABS(trans_balance) 
                 END 
            WHEN trans_type = 'PM' 
               THEN ABS(trans_balance) 
                    ELSE
        CASE 
            WHEN trans_type = 'RC'
                 THEN ABS(trans_balance)*-1 
                     ELSE
                     0 
            END                                
    END) AS open_cash,
SUM(CASE WHEN trans_type = 'RC' OR trans_type = 'PM' 
                THEN
                 0 
             ELSE 
             CASE WHEN  trans_date >= CURRENT_DATE - 30 
                THEN 
                     CASE WHEN trans_dc = 'C' 
                         THEN ABS(trans_balance)*-1 
                      ELSE ABS(trans_balance) 
                END 
                ELSE 0 
            END 
    END) AS ONE_MONTH,
    SUM(CASE WHEN trans_type = 'RC' OR trans_type = 'PM' 
            THEN
             0 
             ELSE 
        CASE WHEN  trans_date <= CURRENT_DATE - 31 and trans_date >= CURRENT_DATE - 60
            THEN 
                    CASE WHEN trans_dc = 'C' 
                            THEN ABS(trans_balance)*-1
                         ELSE ABS(trans_balance) 
                    END 
                ELSE
                 0
            END
    END) AS TWO_MONTH,
        SUM(CASE WHEN trans_type = 'RC' OR trans_type = 'PM' 
            THEN
             0 
             ELSE 
        CASE WHEN  trans_date <= CURRENT_DATE - 61 and trans_date >= CURRENT_DATE - 90
            THEN 
                    CASE WHEN trans_dc = 'C' 
                            THEN ABS(trans_balance)*-1
                         ELSE ABS(trans_balance) 
                    END 
                ELSE
                 0
            END
    END) AS THREE_MONTH,
        SUM(CASE WHEN trans_type = 'RC' OR trans_type = 'PM' 
            THEN
             0 
             ELSE 
        CASE WHEN trans_date <= CURRENT_DATE - 91        
            THEN 
                    CASE WHEN trans_dc = 'C' 
                            THEN ABS(trans_balance)*-1
                         ELSE ABS(trans_balance) 
                    END 
                ELSE
                 0
            END
    END) AS over_4_month,
        SUM( CASE  WHEN trans_dc = 'D' 
                         THEN ABS(trans_balance)           
          ELSE ABS(trans_balance)*-1 
    END) AS Balance, trans_pol_id, pr_desc,pr_sap_code, trans_date,sba.acct_sht_desc,
    CASE
        WHEN sbmt.trans_type = 'ADJ' THEN 'JOURNALS'
        WHEN trans_type = 'APC' and pol_trans_type = 'CN' THEN 'CANCELLATION'
        WHEN trans_type = 'CNC' and pol_trans_type = 'CN' THEN 'CANCELLATION'
        WHEN trans_type = 'APD' AND pol_trans_type = 'EX' THEN 'EXTENSION'
        WHEN trans_type = 'APD' AND pol_trans_type = 'EN' THEN 'ENDORSEMENT'
        WHEN trans_type = 'RPC' AND pol_trans_type = 'EN' THEN 'ENDORSEMENT'
        WHEN trans_type = 'BNK' THEN 'BANK CHARGES'
        WHEN trans_type = 'CFO' AND pol_trans_type = 'JVC' THEN 'CLAIM PAYMENT BY JOURNAL'
        WHEN trans_type = 'CFO' AND pol_trans_type = 'CF' THEN 'CLAIM FEE'
        WHEN trans_type = 'NBR'  THEN 'CONTRA'
        WHEN trans_type = 'RNR'  THEN 'CONTRA'
        WHEN trans_type = 'CO' AND pol_trans_type = 'PM' THEN 'PAYMENTS'
        WHEN trans_type = 'COM' THEN 'COMMISSION POSTING'
        WHEN trans_type = 'CPO' THEN 'CLAIM PAYMENT'
        WHEN trans_type = 'CRI' THEN 'CLAIM SALVAGE'
        WHEN trans_type = 'DED' THEN 'DECLARATION'
        WHEN trans_type = 'LOP' THEN 'CLAIM OPENING'
        WHEN trans_type = 'LRV' AND pol_trans_type = 'RP' THEN 'CLAIM REOPENING'
        WHEN trans_type = 'LRV' AND pol_trans_type = 'LR' THEN 'CLAIM REVISION'
        WHEN trans_type = 'MEC' THEN 'MID TERM ENDORSEMENT'
        WHEN trans_type = 'NBD' THEN 'NEW BUSINESS'
        WHEN trans_type = 'RC' THEN 'RECEIPTS'
        WHEN pol_trans_type = 'RE' THEN  'REINSTATEMENT'
        WHEN trans_type = 'RED' THEN 'REINSTATEMENT'
        WHEN trans_type = 'RFC' THEN 'REFUND'
        WHEN trans_type = 'RII' THEN 'REINSURANCE TRANSACTION'
        WHEN trans_type = 'NBC' AND pol_trans_type = 'CO' THEN 'Reversal'
        WHEN trans_type = 'RND' AND pol_trans_type != 'CO' THEN 'RENEWAL'
        WHEN trans_type = 'SPD' THEN 'SHORT PERIOD'
        WHEN trans_type = 'CN' THEN 'Receipt Cancellation'
        WHEN trans_type = 'SAG' THEN 'Sub agent commission'
        WHEN trans_type = 'APD' AND pol_trans_type != 'CO' THEN 'Additional Premium'
        WHEN trans_type = 'APC' AND pol_trans_type != 'CO' THEN 'Refund Premium'
        WHEN pol_trans_type = 'CO' THEN 'Reversal'
        WHEN trans_type = 'BUD' THEN 'BULK UPLOAD'
        else trans_type
    END AS trans_type, sbmt.trans_ref_no,
     sbsg.seg_name AS segment,
CASE 
    WHEN sbmt.trans_lf_endors_no IS NOT NULL AND sbmt.trans_lf_endors_no != '' 
    THEN sbmt.trans_lf_endors_no
    ELSE sbp.pol_rev_no 
END AS pol_rev_no, att.alloc_paid_to_date,
CASE 
    WHEN sbrg.bpg_type = 'L' THEN
        CASE 
            WHEN sbmt.trans_type = 'NBD' THEN coalesce(sbmt.value_date, sbmt.trans_date)
            ELSE COALESCE(att.alloc_paid_to_date, sbmt.value_date, sbmt.trans_date)
        END
    ELSE coalesce(sbmt.value_date, sbmt.trans_date)
END AS value_datee
from sys_brk_organization,sys_brk_main_transactions sbmt
inner  join sys_brk_clients sbc on trans_clnt_code = client_id
LEFT JOIN sys_brk_segments sbsg ON sbsg.seg_id = sbc.client_segment_code
inner join sys_brk_policies sbp on pol_id = trans_pol_id
inner join sys_brk_products sp on pr_code = pol_prod_id
INNER JOIN sys_brk_product_grp AS sbrg ON sbrg.bpg_code = sp.pr_bpg_code
inner join sys_brk_currencies on cur_code = pol_curr_id
inner join sys_brk_branches on ob_id=trans_brn_id
inner join sys_brk_client_types ON cnt_type_id = client_clnt_type
left outer join sys_brk_client_titles ON cnt_title_id = client_title_id
inner join sys_brk_accounts sba ON pol_agent_id = acct_id
LEFT JOIN sys_brk_trans sbt ON trans_tran_no = tran_no
LEFT JOIN (
SELECT 
    MAX(alloc_paid_to_date) AS alloc_paid_to_date,
    alloc_tran_no,
    MAX(alloc_install_no) AS alloc_install_no,
    SUM(COALESCE(alloc_life_whtx_amt,0)) AS alloc_life_whtx_amt,
    SUM(COALESCE(alloc_comm_amt,0)) AS alloc_comm_amt,
    SUM(COALESCE(alloc_marketer_comm_amt,0)) AS marketer_life_comm,
    SUM(COALESCE(alloc_subagent_comm_amt,0)) AS subagent_life_comm,
    SUM(COALESCE(alloc_admin_fee_amt,0)) AS life_admin_fee,
    SUM(COALESCE(alloc_admin_fee_whtx_amt,0)) AS life_admin_fee_vat
FROM sys_brk_life_rct_allocs
GROUP BY alloc_tran_no
) att ON tran_no = att.alloc_tran_no
where (ob_id::varchar) = COALESCE( $P{branch},(ob_id::varchar))
and (cur_code::varchar) = COALESCE( $P{curr},(cur_code::varchar))
AND (($P{Agent} IS NULL) OR (sba.acct_id::varchar = $P{Agent}::varchar))
and date_trunc('day', sbmt.trans_date)  <= $P{asOfDate}
and sbmt.trans_type NOT IN ('RC','CN', 'SAG','RFC','RF')
and sbmt.trans_balance != 0
--and trans_clnt_type = ''
--and trans_dc = 'D'
GROUP BY org_name,ob_name,cur_iso_code,client_id,cnt_title,client_fname,client_onames,pol_no,acct_name,pol_basic_premium_amt,
client_sht_desc,cnt_type_desc, client_clnt_type, value_date,trans_control_acc,
org_address,org_mobile,org_phone,add_email_addr,org_website, trans_pol_id, trans_settle_amt, pr_desc,pr_sap_code,trans_date, pol_rev_no, sbp.pol_sum_insur_amt,
sba.acct_sht_desc, sbmt.trans_type, sbp.pol_trans_type, sbmt.trans_ref_no, sbsg.seg_name, sbmt.trans_lf_endors_no, att.alloc_paid_to_date, sbrg.bpg_type
order by acct_name , trans_date desc]]>
	</queryString>
