<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_clm_activities" pageWidth="879" pageHeight="842" whenNoDataType="BlankPage" columnWidth="756" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="563ed06b-4e1b-4534-b819-bbf6d40a4334">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="absa"/>
	<parameter name="clmId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select clm_id, clm_act_id,  sbca.clm_act_dt, CASE WHEN sbca.clm_act_status = 'Y' THEN 'YES' ELSE 'NO' end as currentactivity, 
       sbca.clm_act_rem_dt , sbca.clm_act_notes, sbu.user_name as actionby ,sbc.ca_desc,sbcb.clm_id
    from sys_brk_causations sbc
       left join sys_brk_clm_activities sbca  on clm_act_status_id = sbc.ca_id 
       INNER JOIN sys_brk_clm_bookings sbcb ON sbcb.clm_id = sbca.clm_act_clm_id
       left join sys_brk_users sbu on sbu.user_id = sbca.clm_act_user_id
       WHERE sbcb.clm_id  = $P{clmId}
       order by clm_act_id]]>
	</queryString>
