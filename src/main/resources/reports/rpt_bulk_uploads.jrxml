<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_bulk_uploads" pageWidth="2450" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1673" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f295ff76-4097-4e7d-ae8a-2ef1703fc0f3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Latest Adapter"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="747"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="242"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="agent" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
sbp.pol_date:: date AS trans_date,
	    CASE 
	        WHEN sbp.pol_business_type = 'N' THEN sbp.pol_ref_no
	        ELSE sbp.pol_proposal_no
	    END AS bulk_receipt_debit_no,
	    sbp.pol_ref_no,
sbp.pol_proposal_no,

        sbp.pol_no,
        sbp.pol_client_pol_no as pol_client_pol_no,
        sbp.pol_trans_type,
        sbp.pol_cover_from,
        sbp.pol_cover_to,
        sbc.client_idno,
        sbc.client_pin,
        sbc.client_fname||'  '||sbc.client_onames as client_name,        
        sbc.client_cif,
        sba.acct_name,
        sbp.pol_business_type ,
        sba.acct_sht_desc,
        sbu.user_name as initiator_name,
           pol_basic_premium_amt AS gross_premium,
           sbbr.ob_sht_desc
        from sys_brk_policies sbp
        left join sys_brk_clients sbc on sbc.client_id = sbp.pol_client_id
        left join sys_brk_accounts sba ON sba.acct_id = sbp.pol_agent_id
        left join sys_brk_branches sbbr on sbbr.ob_id = sbp.pol_branch_id
          left join sys_brk_bulk_en_policy en on en.en_policy_id = sbp.pol_id 
        left join sys_brk_users AS sbu ON sbu.user_id = sbp.pol_created_user
        left join sys_brk_bulk_pol_renewals rn on rn.new_pol_id = sbp.pol_id 
        where (
        CASE 
            WHEN sbp.pol_business_type = 'N' THEN sbp.pol_ref_no
            ELSE sbp.pol_proposal_no
        END
    ) IS NOT null and sbp.pol_trans_type IN ('RN', 'EN', 'BU') AND  sbp.pol_auth_status IN ('CV', 'R')
         AND sbp.pol_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo})
        AND (($P{agent} IS NULL) OR (sba.acct_name::varchar = $P{agent}::varchar))]]>
	</queryString>
