<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_rejected_tickets" pageWidth="3800" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1152" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" uuid="1bf9c828-381b-4849-8fb8-dac124bc168d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="absa_insurance"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[WITH extracted_data AS (
    SELECT 
        mck_id,
        task_name,
        task_json,
        maker_id,
        rejected_reason,
        maker_task_type,
        made_on_date,
        check_on_date,
        checker_id,
        CASE 
            WHEN check_status = 'R' THEN 'Rejected' 
            ELSE 'Approved' 
        END AS check_status,
        CAST((task_json::json ->> 'acctId') AS BIGINT) AS extracted_acctId
    FROM sys_brk_maker_checker sbmc
    WHERE check_status = 'R'
)
SELECT 
    ed.mck_id, 
    COALESCE(ed.task_name, 'NA') AS task_name,
    COALESCE(ed.task_json::text, 'NA') AS task_json_text,
    ed.maker_id, 
    ed.checker_id,
    COALESCE(ed.check_status, 'NA') AS check_status,
    COALESCE(ed.rejected_reason, 'NA') AS rejected_reason,
    COALESCE(ed.maker_task_type, 'NA') AS maker_task_type,
    ed.extracted_acctId,
    COALESCE(sbu.user_name, 'NA') AS maker_name,
    COALESCE(TO_CHAR(ed.made_on_date, 'YYYY-MM-DD HH12:MI AM'), 'NA') AS made_on_date,  -- Formatted date
    COALESCE(sbu2.user_name, 'NA') AS checker_name, 
    COALESCE(TO_CHAR(ed.check_on_date, 'YYYY-MM-DD HH12:MI AM'), 'NA') AS check_on_date,  -- Formatted date
    COALESCE(sba.acct_name, 'NA') AS insurance_name,
    sba.acct_brn_code,
    COALESCE(sbb.ob_name, 'NA') AS branchName,
    COALESCE(sb.bin_name, 'NA') AS bin_name,
    sba.acct_id,
    COALESCE(sba.acct_absa_no, 'NA') AS acct_absa_no,
    COALESCE(sba.acct_email, 'NA') AS acct_email,
    COALESCE(sbat.acc_name, 'NA') AS acc_name,
    COALESCE(sba.acct_phone, 'NA') AS acct_phone,
    COALESCE(sba.acct_bnk_account, 'NA') as acct_bnk_account,
    COALESCE(sba.acct_pin, 'NA') AS acct_pin,
    COALESCE(sbcs.co_code || '-' || sbcs.co_name, 'NA') AS prem_payable_acc,
    COALESCE(sbcs1.co_code || '-' || sbcs1.co_name, 'NA') AS prem_receivable_acc,
    COALESCE(sbcs2.co_code || '-' || sbcs2.co_name, 'NA') AS whtx_acc,
    COALESCE(sbcs3.co_code || '-' || sbcs3.co_name, 'NA') AS comm_acc,
    COALESCE(sbcs4.co_code || '-' || sbcs4.co_name, 'NA') AS admin_acc,
    COALESCE(ROUND(EXTRACT(EPOCH FROM (ed.check_on_date - ed.made_on_date)) / 60, 2)::text, 'NA') AS "Time Pending with (Minutes)"
FROM extracted_data ed
LEFT JOIN sys_brk_users sbu ON sbu.user_id = ed.maker_id
INNER JOIN sys_brk_accounts sba ON sba.acct_id = ed.extracted_acctId
LEFT JOIN sys_brk_users sbu2 ON sbu2.user_id = ed.checker_id
LEFT JOIN sys_brk_branches sbb ON sbb.ob_id = sba.acct_brn_code
LEFT JOIN sys_brk_binders sb ON sb.bin_acct_code = sba.acct_id
LEFT JOIN sys_brk_account_types sbat on sbat.acc_id = sba.acct_acc_code
LEFT JOIN sys_brk_coa_sub sbcs on sbcs.co_id = sba.acct_payable_acct
LEFT JOIN sys_brk_coa_sub sbcs1 on sbcs1.co_id = sba.acct_receivable_acct
LEFT JOIN sys_brk_coa_sub sbcs2 on sbcs2.co_id = sba.acct_whtx_acct
LEFT JOIN sys_brk_coa_sub sbcs3 on sbcs3.co_id = sba.acct_comm_acct
LEFT JOIN sys_brk_coa_sub sbcs4 on sbcs4.co_id = sba.acct_admin_acct
WHERE check_on_date BETWEEN $P{dateFrom} AND $P{dateTo};
]]>
	</queryString>
