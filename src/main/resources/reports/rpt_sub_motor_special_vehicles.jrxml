	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "MAKE/MODEL", "YOM", "WINDSCREEN","COVER TYPE", "REG.MARK", "PASSENGERS"
from "MOTOR SPECIAL VEHICLES" msv
inner join sys_brk_risks sbr on sbr.risk_id = msv.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
