<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_trial_balance_lvl_2" pageWidth="2152" pageHeight="1042" whenNoDataType="AllSectionsNoDetail" columnWidth="1102" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="d977049f-60f5-4b8d-9095-ba3ff06a87cc">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="731"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="255"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Latest Adapter"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="format" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
s2.co_id AS main_acc_id,
s2.co_accounts_order AS main_acc_order,
s2.co_header AS main_co_header,
s2.co_pl_bs,
s1.co_accounts_order,
SUM(COALESCE(opening_balances.opening_debit, 0)) AS opening_debit,
SUM(COALESCE(opening_balances.opening_credit, 0)) AS opening_credit,
SUM(COALESCE(current_trans.debits, 0)) AS debits,
SUM(COALESCE(current_trans.credits, 0)) AS credits,
s2.co_code AS main_acc_code,
s2.co_name AS main_acc_name,
s1.co_code,
s1.co_name,
org.org_address,
org.org_mobile,
org.org_phone,
org.add_email_addr,
org.org_website,
org.org_name
FROM sys_brk_coa_sub s1
INNER JOIN sys_brk_coa_main s2 ON s2.co_id = s1.co_main_acc_id
CROSS JOIN sys_brk_organization org
LEFT JOIN (
-- 🟦 Current period transactions
SELECT
s.gl_account,
SUM(CASE WHEN s.gl_dc = 'D' THEN s.gl_amount ELSE 0 END) AS debits,
SUM(CASE WHEN s.gl_dc = 'C' THEN s.gl_amount ELSE 0 END) * -1 AS credits
FROM sys_brk_gl_trans s
WHERE s.gl_auth_date >= $P{dateFrom}::DATE AND s.gl_auth_date < ($P{dateTo}::DATE + INTERVAL '1 day')
GROUP BY s.gl_account
) AS current_trans ON current_trans.gl_account = s1.co_id
LEFT JOIN (
-- 🟨 Opening balance: before the from-date, only for Balance Sheet accounts
SELECT
s.gl_account,
SUM(CASE WHEN s.gl_dc = 'D' THEN s.gl_amount ELSE 0 END) AS opening_debit,
SUM(CASE WHEN s.gl_dc = 'C' THEN s.gl_amount ELSE 0 END) * -1 AS opening_credit
FROM sys_brk_gl_trans s
INNER JOIN sys_brk_coa_sub s1 ON s.gl_account = s1.co_id
INNER JOIN sys_brk_coa_main s2 ON s2.co_id = s1.co_main_acc_id
WHERE s.gl_auth_date >= DATE_TRUNC('year', $P{dateFrom}::DATE) AND s.gl_auth_date < $P{dateFrom}::DATE
AND s2.co_pl_bs = 'B' -- Only Balance Sheet accounts
GROUP BY s.gl_account
) AS opening_balances ON opening_balances.gl_account = s1.co_id
WHERE s2.co_accounts_order NOT IN ('5', '10') -- Apply your original filter
GROUP BY
s2.co_id,
s2.co_accounts_order,
s2.co_header,
s2.co_pl_bs,
s1.co_accounts_order,
s2.co_code,
s2.co_name,
s1.co_code,
s1.co_name,
org.org_address,
org.org_mobile,
org.org_phone,
org.add_email_addr,
org.org_website,
org.org_name
ORDER BY s2.co_code, s1.co_code, s1.co_accounts_order ASC;]]>
	</queryString>
