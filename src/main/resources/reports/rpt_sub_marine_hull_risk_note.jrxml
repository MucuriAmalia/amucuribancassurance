	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "ENGINE TYPE" , "WEIGHT IN KGS.", "PASSENGER CAPACITY","VALUE OF HULL", "CAPACITY", "MAKE OF ENGINE"
from "MARINE HULL" mps 
inner join sys_brk_risks sbr on sbr.risk_id = mps.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
