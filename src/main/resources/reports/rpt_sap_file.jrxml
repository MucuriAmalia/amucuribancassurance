<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_sap_file" pageWidth="1540" pageHeight="595" whenNoDataType="AllSectionsNoDetail" columnWidth="1300" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1bf9c828-381b-4849-8fb8-dac124bc168d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Adapter"/>
	<parameter name="logo" class="java.lang.Object"/>
	<queryString language="SQL">
		<![CDATA[SELECT
	sbs.seg_code as BUKRS,
	scs.co_code as HKONT,
	sbpr.pr_desc as SGTXT,
	CASE WHEN sbgt.gl_dc = 'D' THEN sbgt.gl_amount ELSE 0 END as WRSOL,
	CASE WHEN sbgt.gl_dc = 'C' THEN sbgt.gl_amount ELSE 0 END as WRHAB,
	'' as MWSKZ,
	'' as KOSTL,
	sbs.seg_comp_code as PRCT,
	sbs.seg_segment as SEGMENT,
	sbpr.pr_sap_code as MATNR_EXT,
	'KIB99999' as FKBER,
	'KIB99999' as VBUND,
	'' as RMVCT
FROM sys_brk_gl_trans sbgt  
LEFT JOIN sys_brk_coa_sub scs ON scs.co_id = sbgt.gl_account  
LEFT JOIN sys_brk_coa_main sbcm ON scs.co_main_acc_id = sbcm.co_id  
LEFT JOIN sys_brk_policies sbp ON sbp.pol_id = sbgt.gl_policy_trans_id  
LEFT JOIN sys_brk_clients sbc ON sbc.client_id = sbp.pol_client_id  
LEFT JOIN sys_brk_products sbpr ON sbpr.pr_code = sbp.pol_prod_id  
LEFT JOIN sys_brk_segments sbs ON sbs.seg_id = sbc.client_segment_code  
WHERE sbgt.gl_trans_type = 'COMM'  
ORDER BY sbgt.gl_trans_no]]>
	</queryString>
