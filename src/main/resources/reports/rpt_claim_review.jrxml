<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_claim_review" pageWidth="2100" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1062" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="20" uuid="23a07438-245c-4eed-b6df-048a58b30f40">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT clm_no, clm_date, clm_booked_dt, clm_loss_desc, clm_next_rvw_dt, sbp.pol_agent_id, pol_client_pol_no,sbp.pol_no,sbu.user_name as clm_booked_by,
       sbcb.clm_risk_id,sbc2.ca_desc, sbb.ob_name,acct_name,sbr.risk_sht_desc,sbcp.clm_pymt_created_dt, clm_status,
       sbr.risk_id, sbc.client_fname ||' '||sbc.client_onames as client_names, sbcs.clm_sts_remarks,sbp4.p_desc,
       sbp3.pr_desc, sbcp.clm_pymt_amount, sbc3.clmnt_surname ||' '||sbc3.clmnt_othernames as claimant ,coalesce(sbcp2.clm_prl_paid_amount, 0) as clm_prl_paid_amount
FROM sys_brk_accounts sba 
INNER JOIN sys_brk_policies sbp ON sba.acct_id = sbp.pol_agent_id
INNER JOIN sys_brk_risks sbr ON sbr.risk_pol_id = sbp.pol_id 
INNER JOIN sys_brk_clm_bookings sbcb ON sbcb.clm_risk_id = sbr.risk_id
INNER JOIN sys_brk_clm_activities sbca ON clm_act_clm_id = sbcb.clm_id
LEFT JOIN sys_brk_branches sbb ON sbb.ob_id = sbp.pol_branch_id 
LEFT JOIN sys_brk_clients sbc ON sbc.client_id = sbp.pol_client_id 
LEFT JOIN sys_brk_causations sbc2 ON sbc2.ca_id = sbcb.clm_status_id
LEFT JOIN sys_brk_users sbu ON sbu.user_id = sbcb.clm_booked_by 
LEFT JOIN sys_brk_products sbp3 ON sbp3.pr_code = sbp.pol_prod_id
INNER JOIN sys_brk_clm_statuses sbcs ON clm_sts_clm_id = sbcb.clm_id
left join sys_brk_clm_pymnts sbcp on sbcp.clm_pymt_clm_id = sbcb.clm_id
left join sys_brk_clm_claimants sbcc on sbcc.clm_created_user= sbu.user_id
left join sys_brk_claimants sbc3 on sbc3.created_user= sbu.user_id
LEFT join sys_brk_clm_perils sbcp2 on sbcp2.clm_prl_clm_id = sbcb.clm_id
left join sys_brk_perils sbp4 on sbp4.p_code = sbcp2.clm_prl_peril_id
WHERE pol_agent_id = CAST($P{Agent} AS INTEGER)
AND CAST(clm_date AS DATE) BETWEEN $P{dateFrom} AND $P{dateTo};
]]>
	</queryString>
