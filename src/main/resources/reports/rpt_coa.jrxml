	<queryString language="SQL">
		<![CDATA[SELECT 
    org_name,
    org_mobile,
    org_phone,
    org_address,
    org_website,
    phy_address,
    add_email_addr, 
    sbcm.co_header,
    sbcm.co_code AS co_main_code,
    sbcm.co_name,
    CAST(sbcs.co_code AS NUMERIC) AS co_code,
    sbcs.co_name AS sub_name,
    CAST(sbcs.co_accounts_order AS NUMERIC) AS co_accounts_order,
    sbcs.co_control_acc,
    sbcs.co_mapped_to_scl
from sys_brk_organization sbo, sys_brk_coa_sub sbcs
inner join sys_brk_coa_main sbcm on sbcm.co_id = sbcs.co_main_acc_id  
ORDER BY 
    CAST(sbcs.co_accounts_order AS NUMERIC),sbcm.co_header, CAST(sbcs.co_code AS NUMERIC),sbcs.co_name;]]>
	</queryString>
