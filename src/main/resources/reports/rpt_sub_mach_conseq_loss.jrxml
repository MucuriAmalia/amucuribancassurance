	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "ITEM NO" , "LOCATION" , "SUM INSURED" ,"MACHINERY DESCRIPTION" , "COVER TYPE"
from "MACHINERY CONSEQUENTIAL LOSS" mcl  
inner join sys_brk_risks sbr on sbr.risk_id = mcl.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
