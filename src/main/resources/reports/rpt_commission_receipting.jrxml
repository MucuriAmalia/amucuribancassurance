<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_commission_recepting" pageWidth="3110" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1902" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f295ff76-4097-4e7d-ae8a-2ef1703fc0f3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="944"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="42"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="157"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="836"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Latest Adapter"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="Agent" class="java.lang.String"/>
	<parameter name="paymentStatus" class="java.lang.String"/>
	<queryString>
		<![CDATA[select sbct.ct_date::date,
sbct.ct_authorised, 
    sbp.pol_no,
    debit.trans_ref_no AS "Debit Ref No",
    credit.trans_ref_no AS "Credit Ref No",
    SUM(CASE WHEN ct_trans_type = 'Commission' THEN ct_amount ELSE 0 END) AS "Gross Commission",
    SUM(CASE WHEN ct_trans_type = 'Commission' THEN ct_whtx ELSE 0 END) AS "Commission Whtx",
    SUM(CASE WHEN ct_trans_type = 'Commission' THEN ct_net_amt ELSE 0 END) AS "Net Commission",
    SUM(CASE WHEN ct_trans_type = 'Admin Fee' THEN ct_amount ELSE 0 END) AS "Gross Admin Fee",
    SUM(CASE WHEN ct_trans_type = 'Admin Fee' THEN ct_whtx ELSE 0 END) AS "Admin Whtx",
    SUM(CASE WHEN ct_trans_type = 'Admin Fee' THEN ct_net_amt ELSE 0 END) AS "Net Admin Fee",
    (
    SUM(CASE WHEN ct_trans_type = 'Commission' THEN ct_amount ELSE 0 END) +
    SUM(CASE WHEN ct_trans_type = 'Admin Fee' THEN ct_amount ELSE 0 END)
) AS gross_revenue,
(
    SUM(CASE WHEN ct_trans_type = 'Commission' THEN ct_net_amt ELSE 0 END) +
    SUM(CASE WHEN ct_trans_type = 'Admin Fee' THEN ct_net_amt ELSE 0 END)
) AS net_revenue,
   CASE 
    WHEN SIGN(SUM(CASE WHEN ct_trans_type IN ('Commission', 'Admin Fee') THEN ct_amount ELSE 0 END)) = -1 
        THEN sbp2.pol_client_pol_no
    WHEN SIGN(SUM(CASE WHEN ct_trans_type IN ('Commission', 'Admin Fee') THEN ct_amount ELSE 0 END)) = 1 
        THEN sbp.pol_client_pol_no
END AS underwriter_policy_no,
CASE 
    WHEN SIGN(SUM(CASE WHEN ct_trans_type IN ('Commission', 'Admin Fee') THEN ct_amount ELSE 0 END)) = -1 
        THEN sbp2.pol_underwriter_trans_code
    WHEN SIGN(SUM(CASE WHEN ct_trans_type IN ('Commission', 'Admin Fee') THEN ct_amount ELSE 0 END)) = 1 
        THEN sbp.pol_underwriter_trans_code
END AS underwriter_trans_code,
CASE 
    WHEN SIGN(SUM(CASE WHEN ct_trans_type IN ('Commission', 'Admin Fee') THEN ct_amount ELSE 0 END)) = -1 
        THEN sbp2.pol_basic_premium_amt
    WHEN SIGN(SUM(CASE WHEN ct_trans_type IN ('Commission', 'Admin Fee') THEN ct_amount ELSE 0 END)) = 1 
        THEN sbp.pol_basic_premium_amt
END AS gross_premium,

CASE 
    WHEN SIGN(SUM(CASE WHEN ct_trans_type IN ('Commission', 'Admin Fee') THEN ct_amount ELSE 0 END)) = -1 THEN
        CASE 
            WHEN credit.trans_lf_endors_no IS NOT NULL AND credit.trans_lf_endors_no <> '' 
            THEN credit.trans_lf_endors_no
            ELSE sbp2.pol_rev_no
        END
    WHEN SIGN(SUM(CASE WHEN ct_trans_type IN ('Commission', 'Admin Fee') THEN ct_amount ELSE 0 END)) = 1 THEN
        CASE 
            WHEN debit.trans_lf_endors_no IS NOT NULL AND debit.trans_lf_endors_no <> '' 
            THEN debit.trans_lf_endors_no
            ELSE sbp.pol_rev_no
        END
END AS pol_rev_no
FROM sys_brk_commission_trans sbct
JOIN sys_brk_main_transactions credit ON credit.trans_no = sbct.ct_credit_trans
JOIN sys_brk_main_transactions debit ON debit.trans_no = sbct.ct_debit_trans
JOIN sys_brk_policies sbp ON sbp.pol_id = debit.trans_pol_id
join sys_brk_accounts sba on sba.acct_id = sbp.pol_agent_id 
left join sys_brk_policies sbp2 on sbp2.pol_id = credit.trans_pol_id
WHERE ct_loaded IS null
AND sbct.ct_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second'
 AND (($P{paymentStatus} IS NULL) OR ($P{paymentStatus} = 'Paid' AND sbct.ct_authorised = 'Y') OR ($P{paymentStatus} = 'Unpaid' AND sbct.ct_authorised != 'Y'))
 AND (($P{Agent} IS NULL) OR (sba.acct_id::varchar = $P{Agent}::varchar))
  AND ct_trans_type NOT IN ('Sub Agent Commission')
GROUP BY sbct.ct_date::date, sbp.pol_no, debit.trans_ref_no, credit.trans_ref_no, sbct.ct_authorised,sbp.pol_basic_premium_amt, sbp2.pol_basic_premium_amt, 
debit.trans_lf_endors_no,credit.trans_lf_endors_no, sbp.pol_rev_no, sbp2.pol_rev_no, sbp.pol_underwriter_trans_code, sbp2.pol_underwriter_trans_code, sbp.pol_client_pol_no, sbp2.pol_client_pol_no;]]>
	</queryString>
