<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_sales" pageWidth="2020" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1502" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f295ff76-4097-4e7d-ae8a-2ef1703fc0f3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="1000"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="342"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="651"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="Branch" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT distinct
	sbmt.trans_date:: date AS trans_date,
	sbc.client_id,
	sbc.client_idno,
	sbc.client_pin,
	sbc.client_fname ,
	sbc.client_onames,
	sba.acct_name,
	sbp.pol_no,
    sbp.pol_cover_to, 
    	sbp.pol_basic_premium_amt,
	sbp.pol_cover_from, 
	sbb.ob_name,
	case 
when sbmt.trans_type ='ADJ' 
then 'JOURNALS'
when sbmt.trans_type ='SAG' 
then 'Sub-Agent Commission'
	when trans_type ='APC'
	then 'CANCELLATION'
	when trans_type ='APD' and pol_trans_type = 'EX'
	then 'EXTENSION'
	when trans_type ='APD' and pol_trans_type = 'EN'
	then 'ENDORSEMENT'
	when trans_type ='BNK'
	then 'BANK CHARGES'
	when trans_type ='CFO' and pol_trans_type = 'JVC'
	then 'CLAIM PAYMENT BY JOURNAL'
	when trans_type ='CFO' and pol_trans_type = 'CF'
	then 'CLAIM FEE'
	when trans_type ='CO' and pol_trans_type = 'CO'
	then 'CONTRA'
	when trans_type ='CO' and pol_trans_type = 'PM'
	then 'PAYMENTS'
	when trans_type ='COM' 
	then 'COMMISSION POSTING'
	when trans_type ='CPO' 
	then 'CLAIM PAYMENT'
	when trans_type ='CRI' 
	then 'CLAIM RECOVERY'
	when trans_type ='CRI' 
	then 'CLAIM SALVAGE'
	when trans_type ='DED' 
	then 'DECLARATION'
	when trans_type ='LOP' 
	then 'CLAIM OPENING'
	when trans_type ='LRV' and pol_trans_type = 'RP'
	then 'CLAIM REOPENING'
	when trans_type ='LRV' and pol_trans_type = 'LR'
	then 'CLAIM REVISION'
	when trans_type ='MEC' 
	then 'MID TERM ENDORSEMENT'
	when trans_type ='NBD'
	then 'NEW BUSINESS'
	when trans_type ='RC'
	then 'RECEIPTS'
	when trans_type ='RED'
	then 'REINSTATEMENT OF A POLICY' 
	when trans_type ='RFC'
	then 'REFUND'
	when trans_type ='RII'
	then 'REINSURANCE TRANSACTION'
	when trans_type ='NBC' and pol_trans_type = 'CO'
	then 'Reversal'
	when trans_type ='RND' and pol_trans_type != 'CO'
	then 'RENEWAL'
	when trans_type ='SPD' 
	then 'SHORT PERIOD'
	when trans_type ='CN'
	then 'Receipt Cancellation' 
	when trans_type ='APD' and pol_trans_type != 'CO'
	then 'Additional Premium'
	when trans_type ='APC' and pol_trans_type != 'CO'
	then 'Refund Premium'
	when pol_trans_type = 'CO'
	then 'Reversal'
	when trans_type = 'BUD'
    then 'BULK UPLOAD'
end  as  trans_type,
    coalesce (sbp.pol_total_sum_insured, 0) as pol_total_sum_insured, sbp.pol_outstanding_prem, sbp.pol_wet_date, ac.acct_bnk_account, sbg.gl_account
FROM sys_brk_policies sbp
INNER JOIN sys_brk_clients AS sbc ON sbc.client_id = sbp.pol_client_id
INNER JOIN sys_brk_main_transactions sbmt ON sbp.pol_id = sbmt.trans_pol_id
INNER JOIN sys_brk_accounts AS sba ON sba.acct_id = sbp.pol_agent_id
inner join sys_brk_account_types as sbat on sbat.acc_id = sba.acct_acc_code
inner join sys_brk_binders bin on bin.bin_id = pol_binder_id
inner join sys_brk_accounts ac on ac.acct_id = bin.bin_acct_code
-- inner join sys_brk_coa_sub coa on coa.co_id = ac.acct_receivable_acct
left join sys_brk_branches sbb on sbb.ob_id = sbp.pol_branch_id
left join sys_brk_trans sbt on trans_tran_no = tran_no
left join sys_brk_life_rct_allocs on tran_no = alloc_tran_no
left join sys_brk_gl_trans sbg on sbg.gl_policy_trans_id = pol_id
 where pol_auth_status = 'A'
 and trans_clnt_type = 'C'
and trans_type NOT IN ('RC', 'CN', 'SAG')
--and sbmt.trans_balance = 0
and sbp.pol_cover_from <= NOW() 
and sbmt.trans_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second'
order by trans_date desc;]]>
	</queryString>
