<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_client_statmnt" pageWidth="1785" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1452" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="0e77c0ed-835f-4c0d-9587-6db88c6fe371">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Latest Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="302"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="691"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="949"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="37"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="Client" class="java.lang.String"/>
	<parameter name="format" class="java.lang.String"/>
	<parameter name="asOfDate" class="java.sql.Date"/>
	<queryString language="SQL">
		<![CDATA[select distinct on (client_id,cur_code,trans_date,pol_id)
client_id,pol_id, client_cif,
client_fname,client_onames,client_address,client_sht_desc,acct_address,
client_phone,client_email,client_sms_number,client_pin,cur_iso_code,client_idno,cur_code,
CASE 
    WHEN trans_type = 'RC' THEN trans_date + INTERVAL '1 seconds'
    ELSE trans_date
END as trans_date,
case 
when trans_type ='ADJ' 
then 'JOURNALS'
	when trans_type ='APC'
	then 'CANCELLATION DR NOTE'
	when trans_type ='CNC'
	then 'CANCELLATION CR NOTE'
	when trans_type ='APD' and pol_trans_type = 'EX'
	then 'EXTENSION'
	when trans_type ='APD' and pol_trans_type = 'EN'
	then 'ENDORSEMENT DR NOTE'
	when trans_type ='RPC' and pol_trans_type = 'EN'
	then 'ENDORSEMENT CR NOTE'
	when trans_type ='BNK'
	then 'BANK CHARGES'
	when trans_type ='CFO' and pol_trans_type = 'JVC'
	then 'CLAIM PAYMENT BY JOURNAL'
	when trans_type ='CFO' and pol_trans_type = 'CF'
	then 'CLAIM FEE'
	WHEN trans_type = 'NBR'  THEN 'CONTRA'
     WHEN trans_type = 'RNR'  THEN 'CONTRA'
	when trans_type ='CO' and pol_trans_type = 'PM'
	then 'PAYMENTS'
	when trans_type ='COM' 
	then 'COMMISSION POSTING'
	when trans_type ='CPO' 
	then 'CLAIM PAYMENT'
	when trans_type ='CRI' 
	then 'CLAIM RECOVERY'
	when trans_type ='CRI' 
	then 'CLAIM SALVAGE'
	when trans_type ='DED' 
	then 'DECLARATION'
	when trans_type ='LOP' 
	then 'CLAIM OPENING'
	when trans_type ='LRV' and pol_trans_type = 'RP'
	then 'CLAIM REOPENING'
	when trans_type ='LRV' and pol_trans_type = 'LR'
	then 'CLAIM REVISION'
	when trans_type ='MEC' 
	then 'MID TERM ENDORSEMENT'
	when trans_type ='NBD'
	then 'NEW BUSINESS'
	when trans_type ='RC'
	then 'RECEIPTS'
	when pol_trans_type ='RE'
	then 'REINSTATEMENT' 
	when trans_type ='RED'
	then 'REINSTATEMENT' 
	when trans_type ='RFC'
	then 'REFUND'
	when trans_type ='RF'
	then 'REFUND'
	when trans_type ='RII'
	then 'REINSURANCE TRANSACTION'
	when trans_type ='NBC' and pol_trans_type = 'CO'
	then 'Reversal'
	when trans_type ='RND' and pol_trans_type != 'CO'
	then 'RENEWAL'
	when trans_type ='SPD' 
	then 'SHORT PERIOD'
	when trans_type ='CN'
	then 'Receipt Cancellation' 
	when trans_type ='APD' and pol_trans_type != 'CO'
	then 'Additional Premium'
	when trans_type ='APC' and pol_trans_type != 'CO'
	then 'Refund Premium'
	when pol_trans_type = 'CO'
	then 'Reversal'
		when trans_type ='BUD' 
	then 'BULK UPLOAD'
end  as  TRAN_DESC,
trans_ref_no MTRAN_REF_NO,
CASE 
    WHEN (pol_no IS NULL OR pol_no = '') AND trans_type != 'RC' THEN pol_proposal_no
    WHEN (pol_no IS NULL OR pol_no = '') AND trans_type = 'RC' THEN receipt_desc
    ELSE pol_no
END AS pol_no,
acct_name,
pr_desc MTRAN_NARRATIONS,
trans_amount,
trans_settle_amt settlements,
trans_net_amt MTRAN_NET_AMT,
trans_no ,client_id agn_code,trans_clnt_type,trans_clnt_code,
client_sht_desc agn_sht_desc, client_onames||' '||client_fname agn_name,client_status,
client_email agn_email_address, client_address agn_postal_address,trans_control_acc,trans_type ref_no,
trans_other_ref,
trans_balance mtran_balance, client_fname insured,pol_wef_date pol_policy_cover_from,cur_iso_code mtran_cur_symbol,
trans_tl mtran_tl,trans_sd mtran_sd,trans_whtx mtran_whtx,trans_extras mtran_extras,trans_comm mtran_commission,
trans_whtx MTRAN_PHFUND, trans_dc ordby, pr_remarks POL_REMARKS ,
trans_narrations MTRAN_NARRATIONS1, receipt_desc,sblr.receipt_value_date, alloc_paid_to_date,
CASE 
    WHEN sbmt.trans_type = 'RC' THEN 
        CASE 
            WHEN sbp.pol_business_type= 'L' THEN COALESCE(sblr.receipt_value_date, sbmt.trans_date)
            ELSE COALESCE(sbr.receipt_date, sbmt.trans_date)
        END
    WHEN sbp.pol_business_type = 'L' THEN 
        CASE 
            WHEN sbmt.trans_type = 'NBD' THEN COALESCE(sbmt.value_date, sbmt.trans_date)
            ELSE COALESCE(att.alloc_paid_to_date, sbmt.trans_date)
        END
    ELSE COALESCE(sbmt.value_date, sbmt.trans_date)
END AS value_dateee
from sys_brk_organization,sys_brk_main_transactions sbmt
inner  join sys_brk_clients sbc on trans_clnt_code = client_id
inner join sys_brk_policies sbp on pol_id = trans_pol_id
inner join  sys_brk_accounts sba on pol_agent_id = acct_id
inner join sys_brk_currencies on cur_code = pol_curr_id
inner join sys_brk_products on pr_code = pol_prod_id
left join sys_brk_pol_remarks on pr_policy_id = pol_id
left join sys_brk_receipt_dtls sbrd on sbrd.rect_pol_id = sbp.pol_id 
left join sys_brk_receipts sbr on sbr.receipt_id = sbrd.rect_receipt_no
LEFT JOIN sys_brk_trans sbt ON trans_tran_no = tran_no
LEFT JOIN (
SELECT 
    MAX(alloc_paid_to_date) AS alloc_paid_to_date,
    alloc_tran_no,
    MAX(alloc_install_no) AS alloc_install_no,
    SUM(COALESCE(alloc_life_whtx_amt,0)) AS alloc_life_whtx_amt,
    SUM(COALESCE(alloc_comm_amt,0)) AS alloc_comm_amt,
    SUM(COALESCE(alloc_marketer_comm_amt,0)) AS marketer_life_comm,
    SUM(COALESCE(alloc_subagent_comm_amt,0)) AS subagent_life_comm,
    SUM(COALESCE(alloc_admin_fee_amt,0)) AS life_admin_fee,
    SUM(COALESCE(alloc_admin_fee_whtx_amt,0)) AS life_admin_fee_vat
FROM sys_brk_life_rct_allocs
GROUP BY alloc_tran_no
) att ON tran_no = att.alloc_tran_no
LEFT JOIN (
    SELECT receipt_value_date, lrct_receipt_id, lrct_trans_no
    FROM sys_brk_life_rcts
) sblr ON sbmt.trans_no = sblr.lrct_trans_no
where (($P{Client} IS NULL) OR (client_id::varchar = $P{Client}::varchar))
and date_trunc('day', trans_date)  <= $P{asOfDate}
and  trans_type != 'SAG'
and sbp.pol_auth_status = 'A'
order by client_id,cur_code,trans_date desc, pol_id]]>
	</queryString>
