	<parameter name="format" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT org_name,org_address,org_mobile,org_phone,add_email_addr,org_website,
client_fname,client_onames,cnt_type_desc,acct_name,acct_sht_desc,ob_name,pr_desc,pol_no,bru.user_name,
 pol_date,pol_wef_date,pol_wet_date, pol_sum_insur_amt,pol_basic_premium_amt, sbel.esc_level_role_name
 from sys_brk_organization, sys_brk_policies
 inner join sys_brk_clients on client_id = pol_client_id
 inner join sys_brk_client_types on cnt_type_id = client_clnt_type
 inner join sys_brk_accounts on pol_agent_id = acct_id
 inner join sys_brk_branches on ob_id = pol_branch_id
 inner join sys_brk_products on pr_code = pol_prod_id
 inner join sys_brk_users bru on bru.user_id = pol_created_user
 inner join sys_brk_maker_checker sbmc2 on sbmc2.maker_id  = bru.user_id
 inner join sys_brk_escalation_record sber on sber.mck_id = sbmc2.mck_id 
 left join sys_brk_escalation_level sbel on sber.esc_level_id = sbel.esc_level_id 
 left join sys_brk_users sbu on sbu.user_id = sber.user_id 
 
 where pol_auth_status = 'R' and sbmc2.check_status = 'N'
 and pol_date between   $P{dateFrom}  and $P{dateTo}
 order by acct_sht_desc,ob_name]]>
	</queryString>
