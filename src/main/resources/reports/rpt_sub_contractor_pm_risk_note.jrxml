	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select cp."INSURED ITEM", cp."SUM INSURED" , cp."DEDUCTABLES" , cp."ITEM NO", cp."CONSTRUCTION SITE" 
from "CONTRACTUAL PM" cp 
inner join sys_brk_risks sbr on sbr.risk_id = cp.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
