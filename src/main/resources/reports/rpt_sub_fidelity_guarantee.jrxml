	<queryString language="SQL">
		<![CDATA[select  "LOCATION" , "SUM INSURED" ,"INSURED PERSONS" 
from "FIDELITY GUARANTEE SCHEDULES" fg   
inner join sys_brk_risks sbr on sbr.risk_id = fg.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
