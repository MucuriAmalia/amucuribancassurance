<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_updated_policies" pageWidth="2300" pageHeight="595" whenNoDataType="AllSectionsNoDetail" columnWidth="660" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1bf9c828-381b-4849-8fb8-dac124bc168d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="absa2_absa2"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="agentCode" class="java.lang.Long"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="status" class="java.lang.Boolean"/>
	<queryString language="SQL">
		<![CDATA[SELECT sbp.pol_ref_no, 
       sbc.client_fname || ' ' || sbc.client_onames AS client_name,
       sba.acct_name,
       sbp.pol_no, 
       CASE 
           WHEN sbp.client_pol_update_status = TRUE THEN 'Updated'
           ELSE 'Pending'
       END AS pol_update_status,
       pol_auth_status, 
       pol_current_status,
       sbucp.insurer_code,
       sbucp.risk_note_no,
       sbucp.underwriter_pol_no,
       sbucp.uploaded_date,
       sbp.pol_client_pol_no, 
       sbp2.pr_desc, 
       sbucp.processed_date, 
       sbp.pol_auth_date 
FROM sys_brk_policies sbp  
LEFT JOIN sys_brk_update_client_polno sbucp ON sbucp.policy_id = sbp.pol_id  
INNER JOIN sys_brk_products sbp2 ON sbp2.pr_code = sbp.pol_prod_id  
INNER JOIN sys_brk_clients sbc ON sbc.client_id = sbp.pol_client_id  
INNER JOIN sys_brk_accounts sba ON sba.acct_id = sbp.pol_agent_id  
WHERE pol_auth_status = 'A'  
AND pol_current_status != 'CN'  
AND pol_rev_status != 'CN'  
AND sbp.pol_auth_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second'  
AND sbp.pol_agent_id = COALESCE($P{agentCode}, sbp.pol_agent_id)  
AND sbp.client_pol_update_status = $P{status}  
ORDER BY sbp.pol_auth_date DESC]]>
	</queryString>
