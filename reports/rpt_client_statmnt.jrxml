<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_client_statmnt" pageWidth="1042" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1002" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="0e77c0ed-835f-4c0d-9587-6db88c6fe371">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Absa"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="Client" class="java.lag.String"/>
	<parameter name="asOfDate" class="java.sql.Date"/>
	<queryString language="SQL">
		<![CDATA[select
	client_id,
	pol_id,
	org_name,
	org_mobile ,
	org_phone,
	org_address,
	org_website,
	phy_address,
	add_email_addr,
	client_fname,
	client_onames,
	client_address,
	client_sht_desc,
	acct_address,
	client_phone,
	client_email,
	client_sms_number,
	client_pin,
	cur_iso_code,
	client_idno,
	cur_code,
	trans_date,
	case
		when trans_type = 'ADJ'
then 'JOURNALS'
		when trans_type = 'APC'
	then 'CANCELLATION'
		when trans_type = 'APD'
		and pol_trans_type = 'EX'
	then 'EXTENSION'
		when trans_type = 'APD'
		and pol_trans_type = 'EN'
	then 'ENDORSEMENT'
		when trans_type = 'BNK'
	then 'BANK CHARGES'
		when trans_type = 'CFO'
		and pol_trans_type = 'JVC'
	then 'CLAIM PAYMENT BY JOURNAL'
		when trans_type = 'CFO'
		and pol_trans_type = 'CF'
	then 'CLAIM FEE'
		when trans_type = 'CO'
		and pol_trans_type = 'CO'
	then 'CONTRA'
		when trans_type = 'CO'
		and pol_trans_type = 'PM'
	then 'PAYMENTS'
		when trans_type = 'COM'
	then 'COMMISSION POSTING'
		when trans_type = 'CPO'
	then 'CLAIM PAYMENT'
		when trans_type = 'CRI'
	then 'CLAIM RECOVERY'
		when trans_type = 'CRI'
	then 'CLAIM SALVAGE'
		when trans_type = 'DED'
	then 'DECLARATION'
		when trans_type = 'LOP'
	then 'CLAIM OPENING'
		when trans_type = 'LRV'
		and pol_trans_type = 'RP'
	then 'CLAIM REOPENING'
		when trans_type = 'LRV'
		and pol_trans_type = 'LR'
	then 'CLAIM REVISION'
		when trans_type = 'MEC'
	then 'MID TERM ENDORSEMENT'
		when trans_type = 'NBD'
	then 'NEW BUSINESS'
		when trans_type = 'RC'
	then 'RECEIPTS'
		when trans_type = 'RED'
	then 'REINSTATEMENT OF A POLICY'
		when trans_type = 'RFC'
	then 'REFUND'
		when trans_type = 'RII'
	then 'REINSURANCE TRANSACTION'
		when trans_type = 'NBC'
		and pol_trans_type = 'CO'
	then 'Reversal'
		when trans_type = 'RND'
		and pol_trans_type != 'CO'
	then 'RENEWAL'
		when trans_type = 'SPD'
	then 'SHORT PERIOD'
		when trans_type = 'CN'
	then 'Receipt Cancellation'
		when trans_type = 'APD'
		and pol_trans_type != 'CO'
	then 'Additional Premium'
		when trans_type = 'APC'
		and pol_trans_type != 'CO'
	then 'Refund Premium'
		when pol_trans_type = 'CO'
	then 'Reversal'
	end as TRAN_DESC,
	trans_ref_no MTRAN_REF_NO,
	pol_no,
	acct_name,
	pr_desc MTRAN_NARRATIONS,
	trans_amount,
	trans_settle_amt settlements,
	trans_net_amt MTRAN_NET_AMT,
	trans_no ,
	client_id agn_code,
	trans_clnt_type,
	trans_clnt_code,
	client_sht_desc agn_sht_desc,
	client_onames || ' ' || client_fname agn_name,
	client_status,
	client_email agn_email_address,
	client_address agn_postal_address,
	trans_control_acc,
	trans_type ref_no,
	trans_other_ref,
	trans_balance mtran_balance,
	client_fname insured,
	pol_wef_date pol_policy_cover_from,
	cur_iso_code mtran_cur_symbol,
	trans_tl mtran_tl,
	trans_sd mtran_sd,
	trans_whtx mtran_whtx,
	trans_extras mtran_extras,
	trans_comm mtran_commission,
	trans_whtx MTRAN_PHFUND,
	trans_dc ordby,
	pr_remarks POL_REMARKS ,
	trans_narrations MTRAN_NARRATIONS1
from
	sys_brk_organization,
	sys_brk_main_transactions
inner join sys_brk_clients on
	trans_clnt_code = client_id
inner join sys_brk_policies on
	pol_id = trans_pol_id
inner join sys_brk_accounts on
	pol_agent_id = acct_id
inner join sys_brk_currencies on
	cur_code = pol_curr_id
inner join sys_brk_products on
	pr_code = pol_prod_id
left join sys_brk_pol_remarks on
	pr_policy_id = pol_id
where
	(client_id::varchar) = coalesce( $P{Client},(client_id::varchar))
	and date_trunc('day', trans_date) <= $P{asOfDate}
	and trans_type != 'SAG'
order by
	client_id,
	cur_code,
	trans_date desc]]>
	</queryString>
