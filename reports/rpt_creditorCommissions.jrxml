	<queryString language="SQL">
		<![CDATA[SELECT  org_address,org_mobile, org_phone,add_email_addr,org_website,org_name,  client_fname||' '||client_onames client ,
pa_comm,pa_settle_dr_ref_no, pa_amount, pa_post_dt,pa_settle_rec_ref_no, pa_trans_type, pa_whtx, pa_posted_by,
pa_settle_cr_id, sbmt1.trans_date, sbp.pol_no, sbp.pol_basic_premium_amt gross_prem, sbp.pol_calc_premium_amt basic_prem,
cur_name, sbmt1.trans_ref_no, sbmt1.trans_comm, sum(sbpa.pa_amount) OVER () as pa_total, sba.acct_name, pa_settle_rec_ref_no
from sys_brk_organization, sys_brk_payment_audit sbpa
inner join sys_brk_main_transactions sbmt on sbmt.trans_no = pa_other_trans
inner join sys_brk_main_transactions sbmt1 on sbmt1.trans_no = sbpa.pa_trans_no 
inner join sys_brk_policies sbp on sbp.pol_id = sbmt1.trans_pol_id
inner join sys_brk_clients sbc on sbc.client_id = sbp.pol_client_id 
inner join sys_brk_currencies s1 on s1.cur_code = sbmt1.trans_curr_id
inner join sys_brk_accounts sba on sba.acct_id = sbmt1.trans_agent_code 
where sbmt.trans_no = $P{transno}
GROUP BY org_address, org_mobile, org_phone, add_email_addr, org_website, org_name, 
         client_fname, client_onames, pa_comm, pa_settle_dr_ref_no, pa_amount, 
         pa_post_dt, pa_settle_rec_ref_no, pa_trans_type, pa_whtx, pa_posted_by, 
         pa_settle_cr_id, sbmt1.trans_date, sbp.pol_no, sbp.pol_basic_premium_amt, 
         sbp.pol_calc_premium_amt, cur_name, sbmt1.trans_ref_no, sbmt1.trans_comm, sba.acct_name;]]>
	</queryString>
