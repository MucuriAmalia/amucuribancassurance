	<variable name="Tot_Commission" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pol_total_comm}]]></variableExpression>
	</variable>
	<variable name="Tot_W_TAX" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pol_total_whtx}]]></variableExpression>
	</variable>
	<variable name="Tot_Gross_Premium" class="java.lang.Double" calculation="Sum"/>
	<variable name="Tot_Premium_Paid" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{trans_settle_amt}]]></variableExpression>
	</variable>
	<variable name="Tot_Balance" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{trans_balance}]]></variableExpression>
	</variable>
	<variable name="Tot_Sales_Agent_Commission" class="java.lang.Double" calculation="Sum"/>
	<variable name="comm_aging" class="java.lang.Integer">
		<variableExpression><![CDATA[(int)((new java.util.Date().getTime() - $F{trans_date}.getTime()) / (1000 * 60 * 60 * 24))]]></variableExpression>
	</variable>
	<variable name="comm_aging_category" class="java.lang.String">
		<variableExpression><![CDATA[IF($V{comm_aging} > 90, "Over 90 Days", 
  IF($V{comm_aging} > 60, "61 - 90 Days", 
    IF($V{comm_aging} > 30, "31 - 60 Days", "0 - 30 Days")))]]></variableExpression>
	</variable>
	<variable name="total_gross_premium" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_premium}]]></variableExpression>
	</variable>
	<variable name="total_net_premium" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{pol_net_premium_amt}]]></variableExpression>
	</variable>
	<variable name="total_settlements" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{trans_settle_amt}]]></variableExpression>
	</variable>
	<variable name="total_comm_paid" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{comm_paid}]]></variableExpression>
	</variable>
	<variable name="total_comm_due" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{comm_due}]]></variableExpression>
	</variable>
