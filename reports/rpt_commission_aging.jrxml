<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_commission_aging" pageWidth="3550" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1202" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f295ff76-4097-4e7d-ae8a-2ef1703fc0f3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Local Adapter"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<parameter name="Agent" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT distinct on  (sbmt.trans_no)
    sbmt.trans_no,
    sbmt.trans_date::date AS trans_date,
    sbmt.trans_pol_id,
    sbc.client_id ,
    COALESCE(sbc.client_idno) AS client_idno,
    COALESCE(sbc.client_pin) AS client_pin,
    sbc.client_fname,
    sbc.client_onames,
    seg_name,
    sbp.pol_no,
    COALESCE(sbp.pol_client_pol_no) AS pol_client_pol_no,
    sba.acct_name,
    sbb.ob_name,
    CASE 
        WHEN sbmt.trans_clnt_type = 'C' THEN sbmt.trans_balance 
        ELSE NULL 
    END AS trans_balance,
    sbp.pol_cover_from,
    sbp.pol_cover_to,
    coalesce(sbr.risk_sht_desc) as risk_sht_desc,
    sbp.pol_cover_to, 
	sbp.pol_cover_from, 
	sba.acct_id,
    EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) AS age_in_days,
    CASE 
    WHEN EXTRACT(DAY FROM (now() - sbp.pol_cover_from)) BETWEEN 0 AND 30 THEN 'current'
	ELSE EXTRACT(DAY FROM (now() - sbp.pol_cover_from))::text
    END AS payment_status,
    abs(sbp.pol_sub_agent_amt) as sub_agent_comm,
    COALESCE(sbp.pol_basic_premium_amt) AS pol_basic_premium_amt, 
   CASE 
	    WHEN bpg_type = 'L' THEN COALESCE(alloc_comm_amt, 0) 
	    ELSE COALESCE(ABS(sbp.pol_total_comm), 0) 
	END AS pol_total_comm,
    sbp.pol_total_sum_insured,
    COALESCE(sbp.pol_total_sd,0) + COALESCE(sbp.pol_tot_train_levy,0) + COALESCE(sbp.pol_tot_phcf,0) AS taxes, 
    coalesce(sbmt.trans_extras, 0) as trans_extras,
    coalesce(sbp.pol_total_whtx, 0) as pol_total_whtx,
    CASE 
        WHEN sbrg.bpg_desc = 'LIFE' THEN 'LONG TERM' 
        ELSE 'SHORT TERM'
    END AS insurance_type,
    bpg_desc,
    sbbs.cl_desc,
    sp.pr_desc,
    sbrg.bpg_type,
    sbc2.cov_desc,
    coalesce(sbp.pol_basic_premium_amt,0) AS gross_premium,
    sbmt.trans_amount as basic_premium, trans_net_amt
    pa_paid_status,
   CASE 
    WHEN pa_paid_status = 'Y' THEN coalesce(pa_amount,0) 
    ELSE 0
END AS comm_paid,
CASE 
    WHEN pa_paid_status IS NULL 
    THEN COALESCE(
        CASE 
            WHEN bpg_type = 'L' THEN COALESCE(alloc_comm_amt, 0) 
            ELSE COALESCE(ABS(sbp.pol_total_comm), 0) 
        END, 
    0)  
    ELSE 0 
END AS comm_due, 
    pa_post_dt,
    receipt_date,
    receipt_acct_id,
    COALESCE(sbmt.trans_settle_amt,0) AS trans_settle_amt,
    sbmt.trans_ref_no, client_cif,sp.pr_sap_code,
    pol_basic_premium_amt AS gross_premium, pol_net_premium_amt
   -- CASE 
        --WHEN EXTRACT(DAY FROM (receipt_date - pa_post_dt)) <= 30 THEN '0-30 Days'
        --WHEN EXTRACT(DAY FROM (receipt_date - pa_post_dt)) > 30 
             --AND EXTRACT(DAY FROM (receipt_date - pa_post_dt)) <= 60 THEN '31-60 Days'
        --WHEN EXTRACT(DAY FROM (receipt_date - pa_post_dt)) > 60 
             --AND EXTRACT(DAY FROM (receipt_date - pa_post_dt)) <= 90 THEN '61-90 Days'
        --ELSE 'Over 90 Days'
    --END AS comm_aging
FROM sys_brk_organization,
     sys_brk_main_transactions sbmt 
INNER JOIN sys_brk_clients AS sbc ON sbc.client_id = sbmt.trans_clnt_code  
INNER JOIN sys_brk_policies AS sbp ON sbp.pol_id = sbmt.trans_pol_id
INNER JOIN sys_brk_accounts AS sba ON sba.acct_id = sbp.pol_agent_id
INNER JOIN sys_brk_branches AS sbb ON sbb.ob_id = sbmt.trans_brn_id
INNER JOIN sys_brk_products AS sp ON sp.pr_code = sbp.pol_prod_id
INNER JOIN sys_brk_product_grp AS sbrg ON sbrg.bpg_code = sp.pr_bpg_code
INNER join sys_brk_risks AS sbr on sbr.risk_pol_id = sbp.pol_id
inner join sys_brk_covertypes sbc2 on sbc2.cov_id = sbr.risk_cover_id
INNER JOIN sys_brk_users AS sbu ON sbu.user_id = sbc.client_created_user 
inner join sys_brk_prod_subcls as sps on sps.ps_pr_code = sp.pr_code
inner join sys_brk_subclasses as sbs on sbs.sub_id = sps.ps_sub_code
inner join sys_brk_classes as sbbs on sbbs.cl_id = sbs.sub_cl_code
inner join sys_brk_account_types as sbat on sbat.acc_id = sba.acct_acc_code
left join sys_brk_payment_audit on  pa_trans_no = trans_no
left join sys_receipts_settlements on pa_settle_cr_id = rec_settle_id
left join sys_brk_segments  on client_segment_code = seg_id
left join sys_brk_receipts on acct_id = receipt_acct_id
left join sys_brk_trans sbt on trans_tran_no = tran_no
left join sys_brk_life_rct_allocs on tran_no = alloc_tran_no
WHERE sbmt.trans_type NOT IN ('RC', 'SAG')
and sbmt.trans_balance = 0
and sbp.pol_cover_from <= NOW() 
AND sbmt.trans_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second'
and (acct_id::varchar) = COALESCE( $P{Agent},(acct_id::varchar))
ORDER BY sbmt.trans_no, sbmt.trans_date DESC;]]>
	</queryString>
