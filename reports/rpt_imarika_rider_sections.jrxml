	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT 
  sbs.sc_sht_desc, sect_amount, sect_calc_prem
FROM sys_brk_rsk_limits sbrl
JOIN sys_brk_sections sbs ON sbs.sc_id = sbrl.sect_sec_id 
JOIN sys_brk_risks s1 ON s1.risk_id = sbrl.sect_risk_id 
JOIN sys_brk_policies sbp ON sbp.pol_id = s1.risk_pol_id 
where sbp.pol_id = $P{polId} AND sc_type='RD']]>
	</queryString>
