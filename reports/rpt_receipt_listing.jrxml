<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_policy_register" pageWidth="1202" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1162" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="20" uuid="23a07438-245c-4eed-b6df-048a58b30f40">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ABSA UPDATED"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="clientid" class="java.lang.String"/>
	<parameter name="date_from" class="java.util.Date"/>
	<parameter name="date_to" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT   
    sbr.receipt_id,
    sbr.receipt_doc_date,
    COALESCE (sbrd.rect_narration, 'No Narration') AS rect_narration,
    sbr.receipt_paid_by,
    sbc.client_fname,
    sbc.client_onames, 
    sbc.client_id,
    sbr.receipt_payment_ref,
    COALESCE(sbr.receipt_cancelled, 'NO') AS receipt_cancelled,
    sbrd.rect_amount,
    sbr.receipt_user,
    sbr.receipt_doc_date,
    sbu1.user_name as receipt_cleared_by,
    sbpm.pm_desc,
    COALESCE(TO_CHAR(sbr.receipt_cleared_date, 'YYYY-MM-DD'), '') AS receipt_cleared_date,
    sbu.user_name,
    org_name, 
    org_mobile, 
    org_phone,
    org_address, 
    org_website, 
    phy_address, 
    add_email_addr
FROM 
    sys_brk_organization, 
    sys_brk_receipts sbr 
LEFT JOIN 
    sys_brk_receipt_dtls sbrd ON sbr.receipt_id = sbrd.rect_receipt_no 
LEFT JOIN 
    sys_brk_users sbu ON sbu.user_id = sbr.receipt_user 
LEFT JOIN 
    sys_brk_users sbu1 ON sbu1.user_id = sbr.receipt_cleared_by
LEFT JOIN 
    sys_brk_policies sbp ON sbrd.rect_pol_id = sbp.pol_id
LEFT JOIN 
    sys_brk_clients sbc ON sbc.client_id = sbp.pol_client_id
INNER JOIN
    sys_brk_payment_modes sbpm ON sbp.pol_pmode_id = pm_id
      where   (client_id::varchar)  =  COALESCE($P{clientid} ,(client_id::varchar))
      and CAST( receipt_doc_date AS date) BETWEEN $P{date_from} and  $P{date_to} 
GROUP BY 
    sbr.receipt_id,
    sbr.receipt_doc_date,
    sbrd.rect_narration,
    sbr.receipt_paid_by,
    sbc.client_fname,
    sbc.client_onames, 
    sbr.receipt_payment_ref,
    receipt_cancelled, 
    sbrd.rect_amount,
    sbr.receipt_user,
    sbr.receipt_doc_date,
    sbr.receipt_cleared_by,
    sbpm.pm_desc,
    sbr.receipt_cleared_date,
    sbu.user_name,
    org_name, 
    org_mobile, 
    org_phone,
    org_address, 
    org_website, 
    phy_address, 
    sbc.client_id,
    add_email_addr,
    sbu1.user_name
    Order by  sbr.receipt_id;]]>
	</queryString>
