	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "ESTIMATED NUMBER OF EMPLOYEES","COVERED","ESTIMATED ANNUAL SALARIES", "OCCUPATION OF EMPLOYEES"
from "WIBA" w
inner join sys_brk_risks sbr on sbr.risk_id = w.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
