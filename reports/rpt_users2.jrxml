	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ABSA UPDATED"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="userid" class="java.lang.String"/>
	<parameter name="date_from" class="java.util.Date"/>
	<parameter name="date_to" class="java.util.Date"/>
	<queryString>
		<![CDATA[select org_mobile,org_address,org_phone,add_email_addr,org_name,org_website,phy_address,sbu.created_date,
case when user_status::int=1 then 'Active' else 'Inactive' end user_status,sbu.created_by,sbu.user_name,sbu.user_username,sbu.user_last_login,sbr.role_name,sbb.ob_name
from  sys_brk_organization,sys_brk_users sbu
left join sys_brk_user_branches sbub on sbub.bub_user_assigned = sbu.user_id 
left join sys_brk_branches sbb on sbb.ob_id = sbub.bub_ob_id
left join sys_brk_user_roles sbur on sbu.user_id = sbur.userId
left join sys_brk_roles sbr on sbur.role_name = sbr.role_id
  where   (user_id::varchar)  =  COALESCE($P{userid} ,(user_id::varchar))]]>
	</queryString>
