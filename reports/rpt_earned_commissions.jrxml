	</parameter>
	<queryString>
		<![CDATA[SELECT 
	org_mobile,org_address,org_phone,add_email_addr,org_name,org_website,
	sbmt.trans_no,
	sbmt.trans_date:: date AS trans_date,
	sbc.client_id,
	COALESCE(sbc.client_idno, 'NA') AS client_idno,
	COALESCE(sbc.client_pin, 'NA') AS client_pin,
	sbc.client_fname ,
	sbc.client_onames,
	sba.acct_name,
	sbp.pol_no,
	sbp.pol_client_pol_no,
	sbmt.trans_ref_no ,
	sbr.risk_sht_desc,
	sbp.pol_cover_to, 
	sbp.pol_cover_from,
	sbc2.cov_desc,
	ROUND(EXTRACT(YEAR FROM AGE(sbp.pol_cover_to, sbp.pol_cover_from)) + 
	     EXTRACT(MONTH FROM AGE(sbp.pol_cover_to, sbp.pol_cover_from)) / 12.0) AS cover_period_years,
	case 
when trans_type ='ADJ' 
then 'JOURNALS'
	when trans_type ='APC'
	then 'CANCELLATION'
	when trans_type ='APD' and pol_trans_type = 'EX'
	then 'EXTENSION'
	when trans_type ='APD' and pol_trans_type = 'EN'
	then 'ENDORSEMENT'
	when trans_type ='BNK'
	then 'BANK CHARGES'
	when trans_type ='CFO' and pol_trans_type = 'JVC'
	then 'CLAIM PAYMENT BY JOURNAL'
	when trans_type ='CFO' and pol_trans_type = 'CF'
	then 'CLAIM FEE'
	when trans_type ='CO' and pol_trans_type = 'CO'
	then 'CONTRA'
	when trans_type ='CO' and pol_trans_type = 'PM'
	then 'PAYMENTS'
	when trans_type ='COM' 
	then 'COMMISSION POSTING'
	when trans_type ='CPO' 
	then 'CLAIM PAYMENT'
	when trans_type ='CRI' 
	then 'CLAIM RECOVERY'
	when trans_type ='CRI' 
	then 'CLAIM SALVAGE'
	when trans_type ='DED' 
	then 'DECLARATION'
	when trans_type ='LOP' 
	then 'CLAIM OPENING'
	when trans_type ='LRV' and pol_trans_type = 'RP'
	then 'CLAIM REOPENING'
	when trans_type ='LRV' and pol_trans_type = 'LR'
	then 'CLAIM REVISION'
	when trans_type ='MEC' 
	then 'MID TERM ENDORSEMENT'
	when trans_type ='NBD'
	then 'NEW BUSINESS'
	when trans_type ='RC'
	then 'RECEIPTS'
	when trans_type ='RED'
	then 'REINSTATEMENT OF A POLICY' 
	when trans_type ='RFC'
	then 'REFUND'
	when trans_type ='RII'
	then 'REINSURANCE TRANSACTION'
	when trans_type ='NBC' and pol_trans_type = 'CO'
	then 'Reversal'
	when trans_type ='RND' and pol_trans_type != 'CO'
	then 'RENEWAL'
	when trans_type ='SPD' 
	then 'SHORT PERIOD'
	when trans_type ='CN'
	then 'Receipt Cancellation' 
	when trans_type ='APD' and pol_trans_type != 'CO'
	then 'Additional Premium'
	when trans_type ='APC' and pol_trans_type != 'CO'
	then 'Refund Premium'
	when pol_trans_type = 'CO'
	then 'Reversal'
end  as  TRAN_DESC,
	sp.pr_desc,
	sbrg.bpg_desc,
    sbrg.bpg_type,
    sbp.pol_total_sum_insured,
    sbp.pol_basic_premium_amt,
    COALESCE(sbp.pol_total_sd,0) + COALESCE(sbp.pol_tot_train_levy,0) + COALESCE(sbp.pol_tot_phcf,0) AS taxes,
    COALESCE(sbmt.trans_settle_amt,0) AS trans_settle_amt,
    ABS(sbp.pol_total_comm) AS pol_total_comm,
    sbp.pol_total_whtx,
    sbp.pol_basic_premium_amt,
    COALESCE((pol_basic_premium_amt) + COALESCE(sbp.pol_total_sd,0) + COALESCE(sbp.pol_tot_train_levy,0)
    	+ COALESCE(sbp.pol_tot_phcf,0) + ABS(sbp.pol_total_comm)) AS gross_premium,
    sbmt.trans_balance
FROM sys_brk_organization,sys_brk_main_transactions sbmt 
INNER JOIN sys_brk_clients AS sbc ON sbc.client_id = sbmt.trans_clnt_code
INNER JOIN sys_brk_policies AS sbp ON sbp.pol_id = sbmt.trans_pol_id
INNER JOIN sys_brk_accounts AS sba ON sba.acct_id = sbp.pol_agent_id
INNER join sys_brk_risks AS sbr on sbr.risk_pol_id = sbp.pol_id 
INNER JOIN sys_brk_products AS sp ON sp.pr_code = sbp.pol_prod_id
INNER JOIN sys_brk_product_grp AS sbrg ON sbrg.bpg_code = sp.pr_bpg_code
inner join sys_brk_covertypes sbc2 on sbc2.cov_id = sbr.risk_cover_id
where trans_type = 'NBD']]>
	</queryString>
