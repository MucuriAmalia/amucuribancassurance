				</textElement>
				<textFieldExpression><![CDATA[($F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(2000000)) < 0 ? "1 Proposal Form" : "")+ 
($F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(2000000)) >= 0 && $F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(3500000)) <= 0 ? 
"1 Proposal Form\n2 Medical Examination Report" : "")+ 
($F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(3500000)) > 0 && $F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(4000000)) < 0 ? 
"1 Proposal Form\n2 Medical Examination Report\n3 Urinalysis" : "")+ 
($F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(4000000)) >= 0 && $F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(5000000)) <= 0 ? 
"1 Proposal Form\n2 Medical Examination Report\n3 Urinalysis\n4 HIV Test" : "")+ 
($F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(5000000)) > 0 && $F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(7000000)) <= 0 ? 
"1 Proposal Form\n2 Medical Examination Report\n3 Urinalysis\n4 HIV Test\n5 Blood Chemistry" : "")+ 
($F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(7000000)) > 0 && $F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(10000000)) <= 0 ? 
"1 Proposal Form\n2 Medical Examination Report\n3 Urinalysis\n4 HIV Test\n5 Blood Chemistry\n6 ECG" : "")+ 
($F{risk_sum_insur_amt}.compareTo(new java.math.BigDecimal(10000000)) > 0 ? 
"1 Proposal Form\n2 Medical Examination Report\n3 Urinalysis\n4 HIV Test\n5 Blood Chemistry\n6 ECG\n7 Chest x-ray\n8 Financial Questionnaire" : "")]]></textFieldExpression>
