<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_imarika_client_quote" pageWidth="805" pageHeight="842" whenNoDataType="BlankPage" columnWidth="765" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="12cdfaf0-6b78-4257-b161-86d77b76476a">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="666"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="320"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ABSA UPDATED"/>
	<parameter name="polId" class="java.lang.Long"/>
	<parameter name="logo" class="java.lang.Object"/>
	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT
  s1.risk_pol_id, 
  org_name, org_mobile, org_phone, org_address, org_website, phy_address,
  add_email_addr, client_fname, client_onames, client_address, client_sht_desc,
  sbp.pol_no,
  sbp.pol_wef_date,
  sbp.pol_wet_date,
  NULL AS pol_expiry_date, 
  s10.cnt_title,
  client_phone, client_email, client_sms_number, client_pin, client_idno, client_gender, client_dob,
  s12.prs_sht_desc, s12.prs_fname, s12.prs_onames, s12.prs_phone, s12.prs_email, s12.prs_idno, s12.prs_pin,
  s12.prs_phone_prefix, s12.prs_gender, s12.prs_dob,
  s1.risk_basic_premium, 
  s1.risk_tax_relief, 
  sbp.pol_phcf, 
  s1.risk_net_premium ,
  s1.risk_sum_insur_amt  , 
  NULL AS quot_date, 
  NULL AS created_by, 
  NULL AS quot_extras,
  NULL AS pm_desc, 
  NULL AS risk_basic_premium, 
  NULL AS quot_pr_converted, 
  NULL AS auth_by, 
  NULL AS quot_auth_date, 
  sbmp.prefix_name as phone_prefix, 
  sbc.cou_prefix, 
  sbmp1.prefix_name AS sms_prefix, 
   NULL AS prospect_prefix, 
  NULL AS prospect_country, 
  s2.client_phone_prefix, 
  s1.risk_annual_prem,
  s1.risk_quartely_prem,
  s1.risk_semi_ann_prem,
  s1.risk_single_prem,
  COALESCE(sbp.pol_rev_bonus, 0) AS pol_rev_bonus,
  COALESCE(sbp.pol_term_bonus, 0) AS pol_term_bonus,
  s4.pr_desc,
  sbu.user_name,
  pol_created_user,
  sbb.ob_name,
  sbp.pol_frequency,
  sbp.pol_term,
  s21.sum_sect_prem,
    s22.sect_basic_prem,
  CASE 
    WHEN client_fname = null THEN 'P' 
    ELSE 'C' 
  END AS quot_clnt_type,
  sbpb.pben_date_reg,
  sbpb.pben_name ,
  sbp.pol_basic_premium_amt
  FROM sys_brk_organization org, sys_brk_risks s1
JOIN sys_brk_policies sbp ON sbp.pol_id = s1.risk_pol_id
LEFT JOIN sys_brk_clients s2 ON sbp.pol_client_id = s2.client_id
LEFT JOIN sys_brk_prospects s12 ON s12.prs_id = s2.client_id
LEFT JOIN sys_brk_client_titles s10 ON s10.cnt_title_id = s2.client_title_id
LEFT JOIN sys_brk_products s4 ON s4.pr_code = sbp.pol_prod_id
left join sys_brk_users sbu on sbu.user_id = sbp.pol_created_user 
left outer join sys_brk_mob_prefix sbmp on sbmp.prefix_id = s2.client_phone_prefix
left outer join sys_brk_countries sbc on sbc.cou_code = sbmp.prefix_cou_code
left outer join sys_brk_mob_prefix sbmp1 on sbmp1.prefix_id = s2.client_sms_prefix 
join sys_brk_branches sbb on sbp.pol_branch_id = sbb.ob_id 
join(
SELECT
 risk_pol_id, sum(sbrl.sect_calc_prem) as sum_sect_prem
FROM sys_brk_rsk_limits sbrl
JOIN sys_brk_sections sbs ON sbs.sc_id = sbrl.sect_sec_id 
JOIN sys_brk_risks ss ON ss.risk_id = sbrl.sect_risk_id 
group by risk_pol_id
) s21 on sbp.pol_id = s21.risk_pol_id
join(
SELECT
 risk_pol_id, sbrl.sect_calc_prem as sect_basic_prem
FROM sys_brk_rsk_limits sbrl
JOIN sys_brk_sections sbs ON sbs.sc_id = sbrl.sect_sec_id 
JOIN sys_brk_risks ss ON ss.risk_id = sbrl.sect_risk_id 
where sbs.sc_type='SI'
group by risk_pol_id,sect_basic_prem
) s22 on sbp.pol_id = s22.risk_pol_id
left join sys_brk_pol_beneficiaries sbpb on sbpb.pben_pol_id = sbp.pol_id
WHERE sbp.pol_id = $P{polId}]]>
	</queryString>
