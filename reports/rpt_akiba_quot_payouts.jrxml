	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT s.pay_date, s.pay_amount, 
       (SELECT SUM(p.pay_amount) 
        FROM sys_brk_pol_payments p 
        WHERE p.pay_pol_id = $P{polId}) AS sum_pay_amount
FROM sys_brk_pol_payments s
WHERE s.pay_pol_id = $P{polId}
]]>
	</queryString>
