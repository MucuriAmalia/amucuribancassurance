	<parameter name="polId" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select "Estimated No. Of Employees", "Estimated annual Wages/Salaries & Other emoluments", "Persons Covered", "Description Of Employees"
from "EMPLOYERS LIABILITY" e
inner join sys_brk_risks sbr on sbr.risk_id = e.s_brk_risks_id
where sbr.risk_pol_id =  $P{polId}]]>
	</queryString>
