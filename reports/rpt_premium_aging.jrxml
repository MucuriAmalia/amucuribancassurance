<!-- Created with Jaspersoft Studio version 6.21.3.final using JasperReports Library version 6.21.3-4a3078d20785ebe464f18037d738d12fc98c13cf  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_premiums" pageWidth="2000" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1202" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f295ff76-4097-4e7d-ae8a-2ef1703fc0f3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ABSA UPDATED"/>
	<parameter name="logo" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="dateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Date From]]></parameterDescription>
	</parameter>
	<parameter name="dateTo" class="java.util.Date">
		<parameterDescription><![CDATA[Date To]]></parameterDescription>
	</parameter>
	<parameter name="Agent" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
	org_mobile,org_address,org_phone,add_email_addr,org_name,org_website,
	sbmt.trans_no,
	sbmt.trans_date:: date AS trans_date,
	sbc.client_id,
	COALESCE(sbc.client_idno, 'NA') AS client_idno,
	COALESCE(sbc.client_pin, 'NA') AS client_pin,
	sbc.client_fname ,
	sbc.client_onames,
	sba.acct_name,
	sbp.pol_no,
	sbp.pol_client_pol_no,
	sbmt.trans_ref_no ,
	sbr.risk_sht_desc,
	sbc2.cov_desc,
	ROUND(EXTRACT(YEAR FROM AGE(sbp.pol_cover_to, sbp.pol_cover_from)) + 
	     EXTRACT(MONTH FROM AGE(sbp.pol_cover_to, sbp.pol_cover_from)) / 12.0) AS cover_period_years,
	sbmt.trans_type,
	sp.pr_desc,
	sbrg.bpg_desc,
    sbrg.bpg_type,
    sbp.pol_total_sum_insured,
    sbp.pol_basic_premium_amt,
    COALESCE(sbp.pol_total_sd,0) + COALESCE(sbp.pol_tot_train_levy,0) + COALESCE(sbp.pol_tot_phcf,0) AS taxes,
    COALESCE(sbmt.trans_settle_amt,0) AS trans_settle_amt,
    ABS(sbp.pol_total_comm) AS pol_total_comm,
    sbp.pol_total_whtx,
    sbp.pol_basic_premium_amt,
    COALESCE((pol_basic_premium_amt) + COALESCE(sbp.pol_total_sd,0) + COALESCE(sbp.pol_tot_train_levy,0)
    	+ COALESCE(sbp.pol_tot_phcf,0) + ABS(sbp.pol_total_comm)) AS gross_premium,
    sbmt.trans_balance
FROM sys_brk_organization,sys_brk_main_transactions sbmt 
INNER JOIN sys_brk_clients AS sbc ON sbc.client_id = sbmt.trans_clnt_code
INNER JOIN sys_brk_policies AS sbp ON sbp.pol_id = sbmt.trans_pol_id
INNER JOIN sys_brk_accounts AS sba ON sba.acct_id = sbp.pol_agent_id
INNER join sys_brk_risks AS sbr on sbr.risk_pol_id = sbp.pol_id 
INNER JOIN sys_brk_products AS sp ON sp.pr_code = sbp.pol_prod_id
INNER JOIN sys_brk_product_grp AS sbrg ON sbrg.bpg_code = sp.pr_bpg_code
inner join sys_brk_covertypes sbc2 on sbc2.cov_id = sbr.risk_cover_id
where trans_date between $P{dateFrom}::date  and $P{dateTo}::date
and (acct_id::varchar) = COALESCE( $P{Agent},(acct_id::varchar))]]>
	</queryString>
