<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_rejected_tickets" pageWidth="3200" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1152" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" uuid="1bf9c828-381b-4849-8fb8-dac124bc168d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="emtech"/>
	<parameter name="logo" class="java.lang.Object"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="Maker" class="java.lang.String"/>
	<parameter name="Checker" class="java.lang.String"/>
	<parameter name="task_type" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    DISTINCT ON (sbmc.mck_id)
    mck_id,
    client_fname,
    client_onames,
    task_name,
    trans_pol_id,
    maker_id,
    maker_task_type,
    made_on_date,
    check_on_date,
    sbpl.pol_cover_to,
    sbpl.pol_cover_from,
    sbpl.pol_term,
    sbpl.pol_no,
 COALESCE(pol_total_sum_insured, 0) AS sum_insured,
   COALESCE(pol_basic_premium_amt, 0) AS gross_premium,
CASE 
    WHEN check_status = 'R' AND rejected_reason IS NOT NULL THEN rejected_reason 
    ELSE COALESCE(
        CASE 
            WHEN check_status = 'A' THEN 'Approved'
            WHEN check_status = 'N' THEN 'New'
            ELSE check_status 
        END, 'Unknown'
    ) 
END AS comment,
    sbu.user_name AS maker_name,
    sbu2.user_name AS checker_name,  
    sba.acct_name,
    CASE 
        WHEN check_status = 'R' THEN 'Rejected' 
        WHEN check_status = 'N' THEN 'New' 
        ELSE 'Approved' 
    END AS check_status,
    sba.acct_id,
    sbp.pr_desc,seg_name,
    sbb.ob_id,sbb.ob_name,
 CASE 
    WHEN maker_task_type = 'ALP' THEN 'LIFE POLICY' 
    WHEN maker_task_type = 'N' THEN 'New' 
    WHEN maker_task_type = 'IM' THEN 'INTERMEDIARY' 
    WHEN maker_task_type = 'RC' THEN 'RECEIPTS' 
    WHEN maker_task_type = 'ANP' THEN 'GENERAL POLICY' 
    WHEN maker_task_type IS NULL THEN 'UNKNOWN' 
    ELSE 'OTHER'  
END AS maker_task_type,
CASE 
    WHEN check_status != 'A' 
    THEN ROUND(EXTRACT(EPOCH FROM (check_on_date - made_on_date)) / 60, 2) 
    ELSE NULL
END AS "Time Pending with (Minutes)",
CASE 
    WHEN check_status = 'A' 
    THEN ROUND(EXTRACT(EPOCH FROM (check_on_date - made_on_date)) / 60, 2) 
    ELSE NULL 
END AS "Total TAT (Minutes)"
FROM sys_brk_maker_checker sbmc
left JOIN sys_brk_users sbu ON sbu.user_id = sbmc.maker_id
left JOIN sys_brk_accounts sba ON sba.acct_activated_user = sbu.user_id
left JOIN sys_brk_users sbu2 ON sbu2.user_id = sbmc.checker_id
left join sys_brk_clients sbc on sbc.client_created_user = sbu.user_id
left join sys_brk_segments sbs on client_segment_code= seg_id
left JOIN sys_brk_policies sbpl ON sbpl.pol_created_user = sbu.user_id
LEFT JOIN sys_brk_branches sbb ON sbb.ob_id = sbpl.pol_branch_id
LEFT JOIN sys_brk_main_transactions sbmt ON trans_pol_id = pol_id
left JOIN sys_brk_products sbp ON sbpl.pol_prod_id= pr_code
where check_on_date BETWEEN DATE($P{dateFrom}) AND DATE($P{dateTo}) + INTERVAL '1 day' - INTERVAL '1 second'
AND ( ($P{Maker} IS NULL) OR (sbu.user_id::varchar = $P{Maker}::varchar))
AND ( ($P{Checker} IS NULL) OR (sbu2.user_id::varchar = $P{Checker}::varchar))
AND ( ($P{task_type} IS NULL) OR (maker_task_type::varchar = $P{task_type}::varchar))]]>
	</queryString>
